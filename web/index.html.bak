    <div class="status-right">
      <span id="polyglot-stack-badge" style="cursor: pointer; display: inline-flex; align-items: center; gap: 5px; padding: 2px 8px; border-radius: 12px; background: rgba(16,185,129,0.12); border: 1px solid rgba(16,185,129,0.3); color: #34d399;" onclick="switchBottomTab('tracker'); toggleBottomTerminal(true);" title="Bofya kuona Mpango wa Kazi na Mazingira">
