<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Anjiru AI — Sovereign African Foundation Intelligence &amp; IDE Workbench</title>
  <link rel="icon" type="image/x-icon" href="/static/anjiru_angel_gabriel.ico">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <!-- Monaco Editor Loader -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.45.0/min/vs/loader.min.js"></script>
  <style>
    :root {
      --bg-titlebar: #0a0d13;
      --bg-activity: #11151e;
      --bg-sidebar: #0b0e14;
      --bg-editor: #121721;
      --bg-terminal: #07090e;
      --bg-input: #0b0e15;
      --bg-card: rgba(17, 24, 39, 0.75);
      --bg-hover: rgba(255, 255, 255, 0.07);
      --bg-active: rgba(16, 185, 129, 0.16);
      --border-color: #1e2634;
      --border-accent: #2d3748;
      --accent-emerald: #10b981;
      --accent-cyan: #06b6d4;
      --accent-rose: #f43f5e;
      --accent-purple: #a855f7;
      --accent-amber: #f59e0b;
      --accent-glow: rgba(16, 185, 129, 0.35);
      --accent-glow-cyan: rgba(6, 182, 212, 0.35);
      --text-main: #f3f6fa;
      --text-dim: #94a3b8;
      --text-muted: #64748b;
      --font-ui: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
      --font-mono: 'JetBrains Mono', 'Consolas', monospace;
      --theme-name: 'Emerald';
    }

    /* THEME 2: CYBERPUNK */
    body.theme-cyberpunk {
      --bg-titlebar: #0d0814;
      --bg-activity: #150e20;
      --bg-sidebar: #0f0a17;
      --bg-editor: #140d21;
      --bg-terminal: #09050d;
      --border-color: #2b183a;
      --border-accent: #43225e;
      --accent-emerald: #ec4899;
      --accent-cyan: #c084fc;
      --accent-glow: rgba(236, 72, 153, 0.4);
      --accent-glow-cyan: rgba(192, 132, 252, 0.4);
      --bg-active: rgba(236, 72, 153, 0.18);
      --theme-name: 'Cyberpunk';
    }

    /* THEME 3: SOLAR GOLD */
    body.theme-solar {
      --bg-titlebar: #120e06;
      --bg-activity: #1a140a;
      --bg-sidebar: #130f07;
      --bg-editor: #181309;
      --bg-terminal: #0a0803;
      --border-color: #332612;
      --border-accent: #523e1c;
      --accent-emerald: #f59e0b;
      --accent-cyan: #fbbf24;
      --accent-glow: rgba(245, 158, 11, 0.4);
      --accent-glow-cyan: rgba(251, 191, 36, 0.4);
      --bg-active: rgba(245, 158, 11, 0.18);
      --theme-name: 'Solar';
    }

    /* THEME 4: OLED MIDNIGHT */
    body.theme-midnight {
      --bg-titlebar: #000000;
      --bg-activity: #050507;
      --bg-sidebar: #020204;
      --bg-editor: #05060a;
      --bg-terminal: #000000;
      --border-color: #161a24;
      --border-accent: #23293a;
      --accent-emerald: #38bdf8;
      --accent-cyan: #818cf8;
      --accent-glow: rgba(56, 189, 248, 0.35);
      --accent-glow-cyan: rgba(129, 140, 248, 0.35);
      --bg-active: rgba(56, 189, 248, 0.16);
      --theme-name: 'Midnight';
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background-color: var(--bg-editor);
      color: var(--text-main);
      font-family: var(--font-ui);
      height: 100vh;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      user-select: none;
      transition: background-color 0.25s ease;
    }

    .shimmer-badge {
      position: relative;
      overflow: hidden;
    }
    .shimmer-badge::after {
      content: "";
      position: absolute;
      top: 0; left: -100%; width: 100%; height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.15), transparent);
      animation: shimmer-flow 3.5s infinite;
    }
    @keyframes shimmer-flow {
      0% { left: -100%; }
      50%, 100% { left: 100%; }
    }

    /* 1. TOP MENU & TITLE BAR */
    #title-bar {
      height: 38px;
      min-height: 38px;
      max-height: 38px;
      background: var(--bg-titlebar);
      border-bottom: 1px solid var(--border-color);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 12px;
      font-size: 12px;
      flex-shrink: 0;
      z-index: 50;
      backdrop-filter: blur(12px);
      overflow: hidden;
    }

    .title-left {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-shrink: 0;
    }

    .app-brand {
      display: flex;
      align-items: center;
      gap: 8px;
      font-weight: 800;
      font-size: 13.5px;
      color: var(--accent-emerald);
      letter-spacing: -0.4px;
      cursor: pointer;
    }
    .app-brand svg { width: 18px; height: 18px; filter: drop-shadow(0 0 6px var(--accent-emerald)); }

    .menu-bar {
      display: flex;
      align-items: center;
      gap: 8px;
      color: var(--text-dim);
      font-size: 12px;
    }

    .menu-item {
      cursor: pointer;
      padding: 3px 6px;
      border-radius: 4px;
      transition: background 0.15s;
    }
    .menu-item:hover { background: var(--bg-hover); color: var(--text-main); }

    .neural-wave-box {
      display: flex;
      align-items: center;
      gap: 6px;
      background: rgba(0, 0, 0, 0.35);
      border: 1px solid var(--border-color);
      border-radius: 6px;
      padding: 2px 6px;
    }
    canvas#header-wave-canvas {
      display: block;
      width: 60px;
      height: 16px;
    }

    .title-center {
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--text-muted);
      display: flex;
      align-items: center;
      gap: 6px;
      max-width: 280px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      flex-shrink: 1;
    }

    .title-center span.active-crumb {
      color: var(--accent-cyan);
      font-weight: 600;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .title-right {
      display: flex;
      align-items: center;
      gap: 6px;
      flex-shrink: 0;
    }

    .btn-layout-toggle {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--border-color);
      color: var(--text-dim);
      font-size: 11.5px;
      padding: 3px 8px;
      border-radius: 5px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 5px;
      font-family: var(--font-ui);
      transition: all 0.15s;
      white-space: nowrap;
    }

    .btn-layout-toggle:hover {
      background: var(--bg-hover);
      color: var(--text-main);
      border-color: var(--border-accent);
      transform: translateY(-1px);
    }

    .btn-layout-toggle.active {
      background: var(--bg-active);
      border-color: var(--accent-emerald);
      color: var(--accent-emerald);
      font-weight: 600;
      box-shadow: 0 0 10px var(--accent-glow);
    }

    kbd.key-hint {
      background: rgba(255, 255, 255, 0.12);
      border-radius: 3px;
      padding: 1px 4px;
      font-family: var(--font-mono);
      font-size: 10px;
      color: #e2e8f0;
    }

    /* 2. MAIN WORKSPACE CONTAINER */
    #workspace-container {
      flex: 1;
      display: flex;
      flex-direction: row;
      overflow: hidden;
      position: relative;
    }

    /* 2.1 ACTIVITY BAR */
    #activity-bar {
      width: 48px;
      background: var(--bg-activity);
      border-right: 1px solid var(--border-color);
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 10px 0;
      gap: 14px;
      flex-shrink: 0;
      z-index: 40;
    }

    .activity-icon {
      width: 38px;
      height: 38px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--text-muted);
      cursor: pointer;
      font-size: 17px;
      transition: all 0.15s ease;
      position: relative;
    }

    .activity-icon:hover { color: var(--text-main); background: var(--bg-hover); }

    .activity-icon.active {
      color: var(--accent-emerald);
      background: var(--bg-active);
      box-shadow: 0 0 12px var(--accent-glow);
    }

    .activity-icon.active::before {
      content: "";
      position: absolute;
      left: -5px;
      width: 3px;
      height: 22px;
      background: var(--accent-emerald);
      border-radius: 0 3px 3px 0;
      box-shadow: 0 0 8px var(--accent-emerald);
    }

    /* =========================================================================
       PHYSICAL SKEUOMORPHIC ICON SYSTEM & DAY-TO-DAY TACTILE ANIMATIONS
       ========================================================================= */
    .phys-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      vertical-align: middle;
      flex-shrink: 0;
      transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), filter 0.2s ease;
    }

    .activity-icon .phys-icon {
      transition: transform 0.24s cubic-bezier(0.34, 1.56, 0.64, 1), filter 0.24s ease;
    }
    .activity-icon:hover .phys-icon {
      transform: translateY(-2.5px) scale(1.12);
      filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.65));
    }
    .activity-icon:active .phys-icon {
      transform: translateY(1.5px) scale(0.95);
      filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.7));
    }

    .btn-phys-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      vertical-align: middle;
      margin-right: 5px;
      transition: transform 0.18s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .btn-layout-toggle:hover .btn-phys-icon,
    .btn-side-action:hover .phys-icon,
    .btn-editor-tool:hover .btn-phys-icon,
    .btn-exec-run:hover .btn-phys-icon {
      transform: translateY(-1px) scale(1.1);
    }
    .btn-layout-toggle:active .btn-phys-icon,
    .btn-side-action:active .phys-icon,
    .btn-editor-tool:active .btn-phys-icon,
    .btn-exec-run:active .btn-phys-icon {
      transform: translateY(1px) scale(0.92);
    }

    /* File item folder flap physical opening animation */
    .file-item .phys-icon {
      transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), filter 0.2s ease;
    }
    .file-item:hover .phys-icon {
      transform: translateY(-1.5px) scale(1.08);
      filter: drop-shadow(0 2px 5px rgba(0, 0, 0, 0.5));
    }
    .file-item:hover .phys-folder-flap {
      transform: skewX(-5deg) scaleY(0.92);
      transform-origin: bottom center;
      transition: transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .file-item:active .phys-icon {
      transform: translateY(1px) scale(0.95);
    }

    /* Status Bar Analog Lamp Pulse */
    @keyframes phys-lamp-breath {
      0%, 100% { filter: drop-shadow(0 0 3px #10b981) brightness(1); }
      50% { filter: drop-shadow(0 0 8px #34d399) brightness(1.3); }
    }
    .phys-lamp-active {
      animation: phys-lamp-breath 3.2s infinite ease-in-out;
    }

    /* Analog Needle Quiver */
    @keyframes phys-needle-quiver {
      0%, 100% { transform: rotate(0deg); }
      25% { transform: rotate(2deg); }
      75% { transform: rotate(-1.5deg); }
    }
    .phys-meter-needle {
      transform-origin: 12px 16px;
      animation: phys-needle-quiver 2.4s infinite ease-in-out;
    }

    /* Thermionic Vacuum Tube Cathode Filament Warm Breathing */
    @keyframes phys-filament-glow {
      0%, 100% { opacity: 0.85; filter: drop-shadow(0 0 2px #f59e0b); }
      50% { opacity: 1; filter: drop-shadow(0 0 6px #fbbf24) brightness(1.2); }
    }
    .phys-filament {
      animation: phys-filament-glow 2.8s infinite ease-in-out;
    }

    /* Precision Clockwork Gears Rotation */
    @keyframes phys-gear-rot {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }
    @keyframes phys-gear-counter-rot {
      from { transform: rotate(0deg); }
      to { transform: rotate(-360deg); }
    }
    .phys-gear-rotate {
      transform-origin: 10px 11px;
    }
    .template-item:hover .phys-gear-rotate,
    .btn-side-action:hover .phys-gear-rotate {
      animation: phys-gear-rot 4s infinite linear;
    }
    .phys-gear-counter {
      transform-origin: 17px 17px;
    }
    .template-item:hover .phys-gear-counter,
    .btn-side-action:hover .phys-gear-counter {
      animation: phys-gear-counter-rot 2.6s infinite linear;
    }

    /* Oscilloscope Beam Trace Sweep */
    @keyframes phys-osc-sweep {
      0% { stroke-dasharray: 24; stroke-dashoffset: 48; opacity: 0.6; }
      50% { stroke-dasharray: 24; stroke-dashoffset: 0; opacity: 1; }
      100% { stroke-dasharray: 24; stroke-dashoffset: -48; opacity: 0.6; }
    }
    .phys-oscilloscope-trace {
      animation: phys-osc-sweep 2.5s infinite linear;
    }

    /* Command Palette Item Physical Hover */
    .palette-item .phys-icon {
      transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), filter 0.2s ease;
    }
    .palette-item:hover .phys-icon,
    .palette-item.selected .phys-icon {
      transform: translateY(-1.5px) scale(1.15);
      filter: drop-shadow(0 3px 6px rgba(0, 0, 0, 0.6));
    }

    /* Template Item Physical Hover */
    .template-item .phys-icon {
      transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .template-item:hover .phys-icon {
      transform: translateY(-1px) scale(1.12);
    }

    /* Editor Tab Physical Hover */
    .editor-tab .phys-icon {
      transition: transform 0.18s ease;
    }
    .editor-tab:hover .phys-icon {
      transform: scale(1.1);
    }

    /* Chat Media Action Button Physical Depression */
    .btn-card-action .phys-icon {
      transition: transform 0.15s ease;
    }
    .btn-card-action:hover .phys-icon {
      transform: translateY(-1px) scale(1.1);
    }
    .btn-card-action:active .phys-icon {
      transform: translateY(1px) scale(0.92);
    }

    /* 2.2 EXPLORER SIDEBAR PANEL (ISOLATED WORKSPACE) */
    #sidebar-panel {
      width: 255px;
      background: var(--bg-sidebar);
      border-right: 1px solid var(--border-color);
      display: flex;
      flex-direction: column;
      flex-shrink: 0;
      transition: width 0.2s ease;
      overflow: hidden;
      position: relative;
    }

    #sidebar-panel.drag-over {
      outline: 2px dashed var(--accent-emerald);
      outline-offset: -3px;
      background: rgba(16, 185, 129, 0.05);
    }

    #sidebar-panel.collapsed { width: 0; border-right: none; }

    .sidebar-section-header {
      padding: 10px 12px 6px 12px;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.8px;
      color: var(--text-muted);
      text-transform: uppercase;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    }

    .sidebar-actions {
      display: flex;
      gap: 4px;
    }

    .btn-side-action {
      background: transparent;
      border: 1px solid transparent;
      color: var(--text-muted);
      cursor: pointer;
      font-size: 12px;
      padding: 2px 5px;
      border-radius: 4px;
      transition: all 0.15s;
    }
    .btn-side-action:hover {
      background: var(--bg-hover);
      color: var(--text-main);
      border-color: var(--border-color);
    }

    .file-tree-list {
      flex: 1;
      overflow-y: auto;
      padding: 6px 6px;
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    /* VS CODE EMPTY WORKSPACE STATE */
    .empty-workspace-view {
      padding: 24px 16px;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 10px;
      color: var(--text-muted);
    }
    .empty-workspace-icon { font-size: 32px; opacity: 0.8; }
    .empty-workspace-title { font-size: 12.5px; font-weight: 700; color: #fff; }
    .empty-workspace-desc { font-size: 11px; line-height: 1.45; color: var(--text-dim); }
    .empty-workspace-actions {
      display: flex;
      flex-direction: column;
      gap: 6px;
      width: 100%;
      margin-top: 6px;
    }
    .btn-workspace-action {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--border-color);
      color: #e2e8f0;
      padding: 6px 10px;
      border-radius: 6px;
      font-size: 11.5px;
      font-weight: 600;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      transition: all 0.15s;
    }
    .btn-workspace-action:hover {
      background: var(--bg-active);
      border-color: var(--accent-emerald);
      color: var(--accent-emerald);
      transform: translateY(-1px);
    }

    /* INLINE CREATE ROW (NO PRIMITIVE POPUPS!) */
    .inline-create-box {
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 5px 8px;
      background: rgba(16, 185, 129, 0.1);
      border: 1px solid var(--accent-emerald);
      border-radius: 5px;
      margin: 4px 0;
      box-shadow: 0 0 10px var(--accent-glow);
    }
    .inline-create-input {
      flex: 1;
      background: transparent;
      border: none;
      outline: none;
      color: #fff;
      font-family: var(--font-mono);
      font-size: 12px;
    }

    .file-item {
      padding: 5px 8px;
      border-radius: 5px;
      font-size: 12px;
      font-family: var(--font-mono);
      color: var(--text-dim);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: space-between;
      transition: all 0.15s;
    }

    .file-item:hover {
      background: var(--bg-hover);
      color: var(--text-main);
    }

    .file-item.active {
      background: var(--bg-active);
      color: var(--accent-emerald);
      font-weight: 600;
      border-left: 2px solid var(--accent-emerald);
    }

    .file-label {
      display: flex;
      align-items: center;
      gap: 6px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      flex: 1;
    }

    .file-actions-hover {
      display: none;
      align-items: center;
      gap: 4px;
    }
    .file-item:hover .file-actions-hover { display: flex; }

    .btn-item-icon {
      background: transparent;
      border: none;
      color: var(--text-muted);
      cursor: pointer;
      font-size: 11px;
      padding: 2px 3px;
      border-radius: 3px;
    }
    .btn-item-icon:hover { color: #fff; background: rgba(255,255,255,0.1); }
    .btn-item-icon.del:hover { color: #ef4444; }

    /* 2.3 SPLIT PANE AREA */
    #panes-wrapper {
      flex: 1;
      display: flex;
      flex-direction: row;
      overflow: hidden;
    }

    /* PANE A: CODE EDITOR */
    #editor-pane {
      flex: 1;
      display: flex;
      flex-direction: column;
      background: var(--bg-editor);
      border-right: 1px solid var(--border-color);
      overflow: hidden;
      position: relative;
    }

    .editor-tabs-bar {
      height: 36px;
      min-height: 36px;
      max-height: 36px;
      background: var(--bg-titlebar);
      border-bottom: 1px solid var(--border-color);
      display: flex;
      align-items: center;
      overflow-x: auto;
      flex-shrink: 0;
    }

    .editor-tab {
      padding: 0 14px;
      height: 100%;
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 12px;
      font-family: var(--font-mono);
      color: var(--text-dim);
      background: transparent;
      border-right: 1px solid var(--border-color);
      border-bottom: 2px solid transparent;
      cursor: pointer;
      white-space: nowrap;
      transition: all 0.15s;
    }

    .editor-tab:hover { background: var(--bg-hover); color: var(--text-main); }
    .editor-tab.active {
      background: var(--bg-editor);
      color: var(--accent-cyan);
      border-bottom: 2px solid var(--accent-emerald);
      font-weight: 600;
      box-shadow: inset 0 -2px 8px var(--accent-glow);
    }

    .tab-close-btn {
      font-size: 10px;
      border-radius: 3px;
      padding: 2px;
      color: var(--text-muted);
    }
    .tab-close-btn:hover { background: rgba(255,255,255,0.15); color: #fff; }

    .editor-toolbar {
      height: 33px;
      min-height: 33px;
      max-height: 33px;
      background: rgba(13, 17, 23, 0.75);
      border-bottom: 1px solid var(--border-color);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 12px;
      font-size: 11.5px;
      color: var(--text-muted);
    }

    .editor-toolbar-actions {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .btn-exec-run {
      background: var(--bg-active);
      border: 1px solid var(--accent-emerald);
      color: var(--accent-emerald);
      padding: 3px 11px;
      border-radius: 5px;
      font-size: 11.5px;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 5px;
      font-family: var(--font-ui);
      transition: all 0.15s;
      box-shadow: 0 0 10px var(--accent-glow);
    }
    .btn-exec-run:hover { background: var(--accent-emerald); color: #000; transform: translateY(-1px); }

    .btn-editor-tool {
      background: transparent;
      border: 1px solid var(--border-color);
      color: var(--text-dim);
      padding: 3px 9px;
      border-radius: 5px;
      font-size: 11px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 4px;
      transition: all 0.15s;
    }
    .btn-editor-tool:hover { background: var(--bg-hover); color: #fff; border-color: var(--border-accent); }

    /* Template Dropdown Menu */
    #template-dropdown-menu {
      position: absolute;
      top: 70px;
      right: 120px;
      background: #0f141d;
      border: 1px solid var(--accent-emerald);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.7), 0 0 15px var(--accent-glow);
      border-radius: 8px;
      z-index: 100;
      display: none;
      flex-direction: column;
      width: 280px;
      overflow: hidden;
    }
    #template-dropdown-menu.open { display: flex; animation: fadeIn 0.12s ease; }

    .template-item {
      padding: 9px 12px;
      display: flex;
      flex-direction: column;
      gap: 2px;
      cursor: pointer;
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
      transition: background 0.12s;
    }
    .template-item:last-child { border-bottom: none; }
    .template-item:hover { background: var(--bg-active); }
    .template-title { font-size: 12px; font-weight: 600; color: #fff; }
    .template-desc { font-size: 10.5px; color: var(--text-dim); }

    #monaco-editor-container {
      flex: 1;
      width: 100%;
      height: 100%;
      overflow: hidden;
    }

    #fallback-editor {
      display: none;
      width: 100%;
      height: 100%;
      background: #0d1117;
      color: #e6edf3;
      font-family: var(--font-mono);
      font-size: 13px;
      line-height: 1.55;
      padding: 14px;
      border: none;
      outline: none;
      resize: none;
      white-space: pre;
    }

    /* IN-EDITOR MEDIA VIEWER FOR NON-CODE FILES */
    #editor-media-preview {
      display: none;
      flex: 1;
      width: 100%;
      height: 100%;
      align-items: center;
      justify-content: center;
      background: #080b11;
      padding: 24px;
      flex-direction: column;
      gap: 16px;
    }

    /* PANE B: ANJIRU AI COPILOT & CHAT */
    #ai-pane {
      flex: 1;
      display: flex;
      flex-direction: column;
      background: #080b10;
      overflow: hidden;
      position: relative;
    }

    .ai-pane-header {
      height: 36px;
      min-height: 36px;
      max-height: 36px;
      background: var(--bg-titlebar);
      border-bottom: 1px solid var(--border-color);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 14px;
      font-size: 12px;
      flex-shrink: 0;
    }

    .ai-header-brand {
      display: flex;
      align-items: center;
      gap: 8px;
      font-weight: 700;
      color: var(--text-main);
    }

    .badge-eco {
      background: var(--bg-active);
      border: 1px solid var(--accent-emerald);
      color: var(--accent-emerald);
      padding: 2px 8px;
      border-radius: 12px;
      font-size: 10.5px;
      font-weight: 700;
      box-shadow: 0 0 8px var(--accent-glow);
    }

    #chat-viewport {
      flex: 1;
      overflow-y: auto;
      padding: 20px 24px;
      display: flex;
      flex-direction: column;
      gap: 24px;
      scroll-behavior: smooth;
    }

    /* Message Rows */
    .msg-user {
      display: flex;
      justify-content: flex-end;
    }

    .bubble-user {
      background: #1e2636;
      border: 1px solid #334155;
      padding: 10px 16px;
      border-radius: 14px 14px 2px 14px;
      font-size: 13px;
      line-height: 1.5;
      max-width: 85%;
      color: #f8fafc;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.4);
    }

    .msg-assistant {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .author-line {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 12px;
      font-weight: 700;
      color: var(--accent-emerald);
    }

    .author-meta { color: var(--text-muted); font-weight: 400; font-size: 11px; }

    /* Collapsible Thought Process Box */
    .thought-box {
      background: rgba(15, 23, 42, 0.55);
      border: 1px solid var(--accent-glow);
      border-radius: 8px;
      overflow: hidden;
      margin: 4px 0 10px 0;
      backdrop-filter: blur(8px);
    }

    .thought-summary {
      padding: 8px 12px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 12px;
      font-weight: 600;
      color: var(--accent-emerald);
      background: var(--bg-active);
      list-style: none;
    }

    .thought-summary::-webkit-details-marker { display: none; }
    .thought-summary:hover { background: rgba(16, 185, 129, 0.22); }

    .thought-steps {
      padding: 10px 14px;
      border-top: 1px solid rgba(16, 185, 129, 0.12);
      display: flex;
      flex-direction: column;
      gap: 8px;
      background: #06090e;
    }

    .thought-step-item {
      padding-left: 10px;
      border-left: 2px solid var(--accent-emerald);
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .thought-step-title { font-size: 11.5px; font-weight: 600; color: #e2e8f0; }
    .thought-step-detail { font-size: 11px; color: var(--text-dim); }

    .assistant-body {
      font-size: 13.5px;
      line-height: 1.65;
      color: #cbd5e1;
    }

    .assistant-body h1, .assistant-body h2, .assistant-body h3 {
      color: #fff;
      margin: 14px 0 6px 0;
    }
    .assistant-body h1 { font-size: 18px; }
    .assistant-body h2 { font-size: 16px; }
    .assistant-body h3 { font-size: 14px; }
    .assistant-body p { margin-bottom: 10px; }
    .assistant-body ul, .assistant-body ol { margin: 6px 0 12px 20px; }
    .assistant-body li { margin-bottom: 5px; }
    .assistant-body strong { color: #fff; }
    .assistant-body hr { border: none; border-top: 1px solid var(--border-color); margin: 14px 0; }

    /* Code Snippet Box inside Assistant */
    .ai-code-card {
      background: #040609;
      border: 1px solid var(--border-accent);
      border-radius: 8px;
      margin: 12px 0;
      overflow: hidden;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
    }

    .ai-code-header {
      background: #0e121a;
      padding: 7px 12px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 11px;
      font-family: var(--font-mono);
      color: var(--text-muted);
      border-bottom: 1px solid #1a202c;
    }

    .ai-code-actions { display: flex; align-items: center; gap: 6px; }

    .btn-card-action {
      background: transparent;
      border: 1px solid var(--border-color);
      color: var(--text-dim);
      padding: 3px 7px;
      border-radius: 4px;
      font-size: 11px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 4px;
      font-family: var(--font-ui);
      transition: all 0.15s;
    }
    .btn-card-action:hover { background: var(--bg-hover); color: #fff; border-color: var(--border-accent); }

    .btn-card-run {
      background: var(--bg-active);
      border-color: var(--accent-emerald);
      color: var(--accent-emerald);
      font-weight: 600;
    }
    .btn-card-run:hover { background: var(--accent-emerald); color: #000; }

    pre.ai-code-content {
      padding: 12px 14px;
      overflow-x: auto;
      font-family: var(--font-mono);
      font-size: 12.5px;
      line-height: 1.5;
      color: #e2e8f0;
    }

    /* RICH MEDIA CARDS */
    .media-card-plot {
      background: #06090e;
      border: 1px solid rgba(6, 182, 212, 0.4);
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.6), 0 0 20px rgba(6, 182, 212, 0.15);
      border-radius: 10px;
      padding: 12px;
      margin: 14px 0;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .media-card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 12px;
      font-weight: 700;
      color: var(--accent-cyan);
    }
    .media-card-plot img {
      width: 100%;
      max-width: 640px;
      border-radius: 6px;
      cursor: zoom-in;
      transition: opacity 0.2s;
    }
    .media-card-plot img:hover { opacity: 0.95; }

    .media-card-audio {
      background: #06080d;
      border: 1px solid var(--accent-glow);
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.6), 0 0 20px var(--accent-glow);
      border-radius: 10px;
      padding: 14px;
      margin: 14px 0;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .audio-wave-visualizer {
      width: 100%;
      height: 48px;
      background: #020306;
      border-radius: 6px;
    }
    .audio-controls-row {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .btn-audio-play {
      background: var(--accent-emerald);
      border: none;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      color: #000;
      font-size: 15px;
      font-weight: bold;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 0 12px var(--accent-emerald);
      transition: transform 0.15s;
    }
    .btn-audio-play:hover { transform: scale(1.08); }

    .media-card-video {
      background: #04060a;
      border: 1px solid var(--accent-glow);
      box-shadow: 0 10px 35px rgba(0, 0, 0, 0.7), 0 0 25px var(--accent-glow);
      border-radius: 10px;
      padding: 12px;
      margin: 14px 0;
    }
    .media-card-video video {
      width: 100%;
      max-width: 640px;
      border-radius: 6px;
      display: block;
    }

    /* AI BOTTOM INPUT DOCK */
    #ai-input-dock {
      background: var(--bg-titlebar);
      border-top: 1px solid var(--border-color);
      padding: 10px 16px 14px 16px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      flex-shrink: 0;
    }

    .studio-quick-bar {
      display: flex;
      align-items: center;
      gap: 6px;
      overflow-x: auto;
      padding: 2px 0;
      scrollbar-width: none;
    }
    .studio-quick-bar::-webkit-scrollbar { display: none; }

    .btn-studio-chip {
      background: rgba(30, 41, 59, 0.7);
      border: 1px solid rgba(148, 163, 184, 0.2);
      color: #94a3b8;
      border-radius: 12px;
      padding: 4px 10px;
      font-size: 11px;
      cursor: pointer;
      white-space: nowrap;
      display: flex;
      align-items: center;
      gap: 5px;
      transition: all 0.15s;
      font-family: var(--font-ui);
    }
    .btn-studio-chip:hover {
      background: var(--bg-active);
      border-color: var(--accent-emerald);
      color: var(--accent-emerald);
      transform: translateY(-1px);
      box-shadow: 0 0 10px var(--accent-glow);
    }

    .ai-input-box {
      background: var(--bg-input);
      border: 1px solid var(--border-accent);
      border-radius: 10px;
      padding: 8px 12px;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .ai-input-box:focus-within {
      border-color: var(--accent-emerald);
      box-shadow: 0 0 0 2px var(--accent-glow);
    }

    textarea#prompt-input {
      background: transparent;
      border: none;
      color: #fff;
      font-family: var(--font-ui);
      font-size: 13px;
      line-height: 1.45;
      resize: none;
      outline: none;
      width: 100%;
      min-height: 38px;
      max-height: 150px;
    }

    .input-dock-controls {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-top: 4px;
      border-top: 1px solid rgba(255, 255, 255, 0.05);
    }

    .input-left-controls {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .btn-circle-action {
      background: transparent;
      border: none;
      color: var(--text-muted);
      cursor: pointer;
      font-size: 14px;
      padding: 4px;
      border-radius: 50%;
    }
    .btn-circle-action:hover { color: #fff; background: var(--bg-hover); }

    select.lang-picker {
      background: #11141a;
      border: 1px solid var(--border-color);
      color: var(--text-dim);
      font-size: 11.5px;
      padding: 3px 8px;
      border-radius: 5px;
      outline: none;
      cursor: pointer;
      font-family: var(--font-ui);
    }

    .btn-send-round {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: var(--accent-emerald);
      border: none;
      color: #000;
      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.15s;
      box-shadow: 0 0 10px var(--accent-glow);
    }
    .btn-send-round:hover { transform: scale(1.08); filter: brightness(1.15); }

    /* 3. BOTTOM PANEL: INTEGRATED TERMINAL */
    #bottom-panel {
      height: 195px;
      background: var(--bg-terminal);
      border-top: 1px solid var(--border-color);
      display: flex;
      flex-direction: column;
      flex-shrink: 0;
      transition: height 0.2s ease;
      z-index: 30;
    }

    #bottom-panel.collapsed { height: 28px; }

    .bottom-panel-header {
      height: 28px;
      min-height: 28px;
      max-height: 28px;
      background: #0a0d13;
      border-bottom: 1px solid var(--border-color);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 12px;
      font-size: 11.5px;
      flex-shrink: 0;
    }

    .bottom-tabs {
      display: flex;
      align-items: center;
      gap: 16px;
      color: var(--text-muted);
    }

    .bottom-tab-btn {
      background: transparent;
      border: none;
      color: var(--text-muted);
      cursor: pointer;
      font-size: 11.5px;
      font-weight: 600;
      padding: 4px 0;
      border-bottom: 2px solid transparent;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .bottom-tab-btn:hover { color: var(--text-main); }
    .bottom-tab-btn.active { color: var(--accent-emerald); border-bottom: 2px solid var(--accent-emerald); }

    .bottom-actions {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .terminal-output-box {
      flex: 1;
      padding: 10px 14px;
      font-family: var(--font-mono);
      font-size: 12px;
      line-height: 1.45;
      color: #94a3b8;
      overflow-y: auto;
      white-space: pre-wrap;
      background: #040609;
    }

    .terminal-input-row {
      display: flex;
      align-items: center;
      padding: 4px 10px;
      background: #080b10;
      border-top: 1px solid #1a202c;
    }

    .terminal-prompt-char {
      color: var(--accent-emerald);
      font-family: var(--font-mono);
      font-size: 12px;
      padding-right: 8px;
    }

    .terminal-quick-input {
      flex: 1;
      background: transparent;
      border: none;
      color: #fff;
      font-family: var(--font-mono);
      font-size: 12px;
      outline: none;
    }

    /* 3.1 POLYGLOT TASK TRACKER STYLES */
    .task-tracker-container {
      flex: 1;
      padding: 10px 14px;
      overflow-y: auto;
      background: #040609;
      display: none;
      flex-direction: column;
      gap: 10px;
      font-size: 11.5px;
    }
    .tracker-header-card {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 8px 12px;
      border-radius: 6px;
      background: rgba(255,255,255,0.03);
      border: 1px solid var(--border-color);
    }
    .tracker-steps-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
      gap: 8px;
    }
    .tracker-step-card {
      background: rgba(15, 20, 29, 0.75);
      border: 1px solid var(--border-color);
      border-radius: 6px;
      padding: 9px 12px;
      display: flex;
      flex-direction: column;
      gap: 5px;
      transition: all 0.2s;
    }
    .tracker-step-card.active {
      border-color: var(--accent-emerald);
      box-shadow: 0 0 10px var(--accent-glow);
    }
    .tracker-step-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-weight: 700;
      color: #e2e8f0;
      font-size: 11.5px;
    }
    .tracker-step-desc {
      font-size: 11px;
      color: var(--text-muted);
      line-height: 1.4;
    }
    .tracker-chip {
      font-size: 10px;
      padding: 2px 7px;
      border-radius: 10px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .chip-pending { background: rgba(148, 163, 184, 0.15); color: #94a3b8; }
    .chip-running { background: rgba(59, 130, 246, 0.2); color: #60a5fa; border: 1px solid #3b82f6; }
    .chip-done { background: rgba(16, 185, 129, 0.2); color: #34d399; border: 1px solid #10b981; }
    .chip-healed { background: rgba(245, 158, 11, 0.2); color: #fbbf24; border: 1px solid #f59e0b; }

    /* 4. STATUS BAR */
    #status-bar {
      height: 24px;
      min-height: 24px;
      max-height: 24px;
      background: var(--bg-titlebar);
      border-top: 1px solid var(--border-color);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 12px;
      font-size: 11px;
      color: var(--text-muted);
      font-family: var(--font-mono);
      flex-shrink: 0;
      z-index: 50;
      overflow: hidden;
      white-space: nowrap;
    }

    .status-left, .status-right {
      display: flex;
      align-items: center;
      gap: 10px;
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
    }

    .status-active-badge {
      display: flex;
      align-items: center;
      gap: 6px;
      color: var(--accent-emerald);
      font-weight: 600;
    }

    .pulse-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--accent-emerald);
      box-shadow: 0 0 8px var(--accent-emerald);
      animation: pulse-ring 2s infinite;
    }
    @keyframes pulse-ring {
      0%, 100% { transform: scale(1); opacity: 1; }
      50% { transform: scale(1.3); opacity: 0.75; }
    }

    /* OVERLAY MODALS (COMMAND PALETTE, QUICK OPEN, CUSTOM CONFIRM) */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.75);
      backdrop-filter: blur(10px);
      display: none;
      align-items: flex-start;
      justify-content: center;
      padding-top: 12vh;
      z-index: 1000;
    }
    .modal-overlay.open { display: flex; animation: fadeIn 0.15s ease; }

    .palette-box {
      width: 620px;
      max-width: 90vw;
      background: #0d121c;
      border: 1px solid var(--accent-glow);
      box-shadow: 0 25px 60px rgba(0, 0, 0, 0.85), 0 0 30px var(--accent-glow);
      border-radius: 12px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }

    .palette-input-wrap {
      display: flex;
      align-items: center;
      padding: 14px 18px;
      border-bottom: 1px solid var(--border-color);
      gap: 12px;
      background: #111724;
    }

    .palette-input {
      flex: 1;
      background: transparent;
      border: none;
      outline: none;
      color: #fff;
      font-size: 14.5px;
      font-family: var(--font-ui);
    }

    .palette-list {
      max-height: 380px;
      overflow-y: auto;
      padding: 8px;
      display: flex;
      flex-direction: column;
      gap: 3px;
    }

    .palette-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 10px 14px;
      border-radius: 8px;
      cursor: pointer;
      font-size: 13px;
      color: #cbd5e1;
      transition: all 0.12s ease;
    }

    .palette-item:hover, .palette-item.selected {
      background: var(--bg-active);
      color: #fff;
      border-left: 3px solid var(--accent-emerald);
      transform: translateX(2px);
    }

    .palette-item-left {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .palette-badge {
      font-family: var(--font-mono);
      font-size: 10.5px;
      background: rgba(255, 255, 255, 0.08);
      padding: 2px 7px;
      border-radius: 4px;
      color: var(--text-muted);
    }

    /* CUSTOM CONFIRM MODAL */
    .confirm-box {
      width: 420px;
      max-width: 90vw;
      background: #0f1624;
      border: 1px solid var(--accent-glow);
      box-shadow: 0 25px 50px rgba(0,0,0,0.85);
      border-radius: 10px;
      padding: 20px;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }
    .confirm-title { font-size: 15px; font-weight: 700; color: #fff; }
    .confirm-msg { font-size: 12.5px; line-height: 1.5; color: var(--text-dim); }
    .confirm-actions { display: flex; justify-content: flex-end; gap: 8px; }

    /* Toast Container */
    #toast-container {
      position: fixed;
      top: 48px;
      right: 18px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      z-index: 9999;
      pointer-events: none;
    }

    .toast-msg {
      background: #0f1624;
      border: 1px solid var(--accent-emerald);
      box-shadow: 0 10px 25px rgba(0,0,0,0.6), 0 0 15px var(--accent-glow);
      color: #fff;
      padding: 10px 14px;
      border-radius: 8px;
      font-size: 12.5px;
      display: flex;
      align-items: center;
      gap: 10px;
      pointer-events: auto;
      animation: slideToast 0.22s ease;
      min-width: 240px;
    }
    @keyframes slideToast {
      from { transform: translateX(100%); opacity: 0; }
      to { transform: translateX(0); opacity: 1; }
    }
    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    /* Welcome state when chat is empty */
    .empty-chat-welcome {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 35px 20px;
      color: var(--text-dim);
    }
    .empty-chat-welcome svg { width: 56px; height: 56px; margin-bottom: 12px; filter: drop-shadow(0 0 10px var(--accent-emerald)); }
    .empty-title { font-size: 19px; font-weight: 800; color: #fff; margin-bottom: 6px; letter-spacing: -0.3px; }
    .empty-sub { font-size: 13px; max-width: 460px; margin-bottom: 22px; line-height: 1.5; color: var(--text-dim); }

    .quick-chips {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      width: 100%;
      max-width: 520px;
    }

    .chip-item {
      background: #0d121c;
      border: 1px solid var(--border-color);
      padding: 10px 12px;
      border-radius: 8px;
      text-align: left;
      cursor: pointer;
      font-size: 12px;
      transition: all 0.15s;
    }
    .chip-item:hover {
      border-color: var(--accent-emerald);
      background: var(--bg-hover);
      color: #fff;
      transform: translateY(-2px);
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
    }
    .chip-item strong { display: block; color: var(--text-main); font-size: 12.5px; margin-bottom: 2px; }
  </style>
</head>
<body>

  <!-- GLOBAL SKEUOMORPHIC PHYSICAL SVG GRADIENTS & TEXTURES -->
  <svg width="0" height="0" style="position:absolute; width:0; height:0; overflow:hidden;" aria-hidden="true">
    <defs>
      <!-- Manila / Kraft Paper Folder Gradients -->
      <linearGradient id="p-fld-back" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#b45309" />
        <stop offset="100%" stop-color="#78350f" />
      </linearGradient>
      <linearGradient id="p-fld-front" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#f59e0b" />
        <stop offset="60%" stop-color="#d97706" />
        <stop offset="100%" stop-color="#b45309" />
      </linearGradient>
      <!-- Antique Brushed Brass / Gold Metallic Gradient -->
      <linearGradient id="p-brass" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#fef08a" />
        <stop offset="35%" stop-color="#eab308" />
        <stop offset="70%" stop-color="#ca8a04" />
        <stop offset="100%" stop-color="#854d0e" />
      </linearGradient>
      <!-- Machined Stainless Steel / Silver Metallic Gradient -->
      <linearGradient id="p-silver" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#ffffff" />
        <stop offset="30%" stop-color="#e2e8f0" />
        <stop offset="70%" stop-color="#94a3b8" />
        <stop offset="100%" stop-color="#475569" />
      </linearGradient>
      <!-- Industrial Oxidized Copper / Rust Plate Gradient -->
      <linearGradient id="p-rust-plate" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#ea580c" />
        <stop offset="45%" stop-color="#c2410c" />
        <stop offset="85%" stop-color="#9a3412" />
        <stop offset="100%" stop-color="#431407" />
      </linearGradient>
      <!-- Indigo Blueprint Paper Gradient -->
      <linearGradient id="p-paper-py" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#0284c7" />
        <stop offset="50%" stop-color="#0369a1" />
        <stop offset="100%" stop-color="#0c4a6e" />
      </linearGradient>
      <!-- Deep Cobalt Drafting Paper Gradient -->
      <linearGradient id="p-paper-ts" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#2563eb" />
        <stop offset="50%" stop-color="#1d4ed8" />
        <stop offset="100%" stop-color="#1e3a8a" />
      </linearGradient>
      <!-- Cream Linen Legal Notepad Gradient -->
      <linearGradient id="p-paper-md" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#fefce8" />
        <stop offset="100%" stop-color="#fef08a" />
      </linearGradient>
      <!-- Floppy Disk Matte Molded Plastic Gradient -->
      <linearGradient id="p-floppy-case" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#334155" />
        <stop offset="50%" stop-color="#1e293b" />
        <stop offset="100%" stop-color="#0f172a" />
      </linearGradient>
      <!-- Emerald Jewel Dome Cap Gradient -->
      <radialGradient id="p-jewel-run" cx="35%" cy="35%" r="65%">
        <stop offset="0%" stop-color="#6ee7b7" />
        <stop offset="45%" stop-color="#10b981" />
        <stop offset="85%" stop-color="#047857" />
        <stop offset="100%" stop-color="#064e3b" />
      </radialGradient>
      <!-- Saddle-Leather Archival Binder Gradient -->
      <linearGradient id="act-binder-cov" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#475569" />
        <stop offset="50%" stop-color="#334155" />
        <stop offset="100%" stop-color="#0f172a" />
      </linearGradient>
      <!-- Studio Microphone Steel Gradient -->
      <linearGradient id="act-mic-steel" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#cbd5e1" />
        <stop offset="50%" stop-color="#64748b" />
        <stop offset="100%" stop-color="#334155" />
      </linearGradient>
      <!-- Acoustic Grille Mesh Pattern / Gradient -->
      <linearGradient id="act-mic-grille" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#1e293b" />
        <stop offset="50%" stop-color="#334155" />
        <stop offset="100%" stop-color="#0f172a" />
      </linearGradient>
      <!-- CRT Chassis Industrial Enclosure Gradient -->
      <linearGradient id="act-crt-chassis" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#334155" />
        <stop offset="50%" stop-color="#1e293b" />
        <stop offset="100%" stop-color="#0b0f19" />
      </linearGradient>
      <!-- Camera Lens Anodized Aluminum Ring Gradient -->
      <linearGradient id="act-lens-ring" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#64748b" />
        <stop offset="50%" stop-color="#334155" />
        <stop offset="100%" stop-color="#0f172a" />
      </linearGradient>
      <!-- Optical Multi-Coated Camera Glass -->
      <radialGradient id="act-lens-glass" cx="40%" cy="40%" r="60%">
        <stop offset="0%" stop-color="#38bdf8" />
        <stop offset="50%" stop-color="#0284c7" />
        <stop offset="85%" stop-color="#1e1b4b" />
        <stop offset="100%" stop-color="#090d16" />
      </radialGradient>
      <!-- Anti-Reflective Optical Coating Specular Reflection -->
      <linearGradient id="act-lens-refl" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#c084fc" />
        <stop offset="100%" stop-color="#34d399" />
      </linearGradient>
    </defs>
  </svg>

  <!-- 1. TOP TITLE & MENU BAR (NO WRAP / CLEAN PANE) -->
  <header id="title-bar">
    <div class="title-left">
      <div class="app-brand" onclick="cycleTheme()" title="Click to cycle Visual Cyber Themes!">
        <img src="/static/angel_gabriel.png" alt="Archangel Gabriel Silhouette" style="width: 26px; height: 26px; border-radius: 6px; border: 1px solid rgba(16,185,129,0.3); object-fit: cover; flex-shrink: 0;" />
        <span>Anjiru.AI</span>
      </div>

      <div class="neural-wave-box" title="Live Neural-Symbolic Activity Frequency Pulse">
        <canvas id="header-wave-canvas" width="60" height="16"></canvas>
      </div>

      <nav class="menu-bar">
        <span class="menu-item" onclick="showInlineCreate('file')">File</span>
        <span class="menu-item" onclick="openCommandPalette()">Edit</span>
        <span class="menu-item" onclick="toggleSidebar('files')">View</span>
        <span class="menu-item" onclick="runActiveEditorFile()">Run</span>
        <span class="menu-item" onclick="toggleBottomTerminal()">Terminal</span>
      </nav>
    </div>

    <div class="title-center">
      <span>workspace</span>
      <span>/</span>
      <span class="active-crumb" id="active-breadcrumb">user_projects</span>
    </div>

    <div class="title-right">
      <button class="btn-layout-toggle" onclick="openCommandPalette()" title="Command Palette (Ctrl + K)">
        <span class="btn-phys-icon">
          <svg class="phys-icon" width="13" height="13" viewBox="0 0 24 24" fill="none">
            <rect x="2" y="9" width="20" height="3.5" rx="0.5" fill="url(#p-silver)" stroke="#475569" stroke-width="0.5"/>
            <line x1="5" y1="9" x2="5" y2="11" stroke="#334155" stroke-width="0.6"/>
            <line x1="8" y1="9" x2="8" y2="10.5" stroke="#334155" stroke-width="0.5"/>
            <line x1="11" y1="9" x2="11" y2="11" stroke="#334155" stroke-width="0.6"/>
            <path d="M2 5V17C2 18 3 18.5 4 17.5L5.5 12.5H2V5Z" fill="url(#p-silver)" stroke="#334155" stroke-width="0.5"/>
            <path d="M12 5V17C12 18 11 18.5 10 17.5L8.5 12.5H13.5V5H12Z" fill="url(#p-brass)" stroke="#78350f" stroke-width="0.5"/>
          </svg>
        </span>
        <kbd class="key-hint">⌘K</kbd> Palette
      </button>
      <button class="btn-layout-toggle" onclick="openQuickOpen()" title="Quick Open File (Ctrl + P)">
        <span class="btn-phys-icon">
          <svg class="phys-icon" width="13" height="13" viewBox="0 0 24 24" fill="none">
            <path d="M2 5.5C2 4.4 2.9 3.5 4 3.5H9.2C9.8 3.5 10.4 3.8 10.8 4.2L12.5 6H20C21.1 6 22 6.9 22 8V18C22 19.1 21.1 20 20 20H4C2.9 20 2 19.1 2 18V5.5Z" fill="url(#p-fld-back)"/>
            <path class="phys-folder-flap" d="M2 9.5C2 8.4 2.9 7.5 4 7.5H20C21.1 7.5 22 8.4 22 9.5V18C22 19.1 21.1 20 20 20H4C2.9 20 2 19.1 2 18V9.5Z" fill="url(#p-fld-front)"/>
          </svg>
        </span>
        <kbd class="key-hint">⌘P</kbd> Files
      </button>
      <button class="btn-layout-toggle" onclick="cycleTheme()" title="Switch Visual Theme Glow">
        <span class="btn-phys-icon">
          <svg class="phys-icon" width="13" height="13" viewBox="0 0 24 24" fill="none">
            <circle cx="12" cy="12" r="10" fill="url(#act-lens-ring)" stroke="#1e293b" stroke-width="0.8"/>
            <circle cx="12" cy="12" r="6.8" fill="url(#act-lens-glass)"/>
            <path d="M7 8C8.5 6.5 11 6 13.5 6.5C10.5 7.5 9 10 9 13.5C7.5 12 7 9.5 7 8Z" fill="url(#act-lens-refl)" opacity="0.85"/>
          </svg>
        </span>
        <span id="theme-btn-label">Emerald</span>
      </button>
      <button class="btn-layout-toggle active" id="btn-mode-split" onclick="setLayoutMode('split')" title="Split Dual Workbench">
        <span class="btn-phys-icon">
          <svg class="phys-icon" width="13" height="13" viewBox="0 0 24 24" fill="none">
            <rect x="2" y="4" width="9.5" height="13" rx="1.5" fill="#1e293b" stroke="url(#p-silver)" stroke-width="0.8"/>
            <rect x="12.5" y="4" width="9.5" height="13" rx="1.5" fill="#0f172a" stroke="url(#p-brass)" stroke-width="0.8"/>
            <line x1="6.7" y1="17" x2="6.7" y2="20" stroke="url(#p-silver)" stroke-width="1.2"/>
            <line x1="17.2" y1="17" x2="17.2" y2="20" stroke="url(#p-brass)" stroke-width="1.2"/>
            <line x1="4" y1="20" x2="20" y2="20" stroke="#475569" stroke-width="1.4"/>
          </svg>
        </span>
        Split
      </button>
      <button class="btn-layout-toggle" id="btn-mode-editor" onclick="setLayoutMode('editor')" title="Editor Only">
        <span class="btn-phys-icon">
          <svg class="phys-icon" width="13" height="13" viewBox="0 0 24 24" fill="none">
            <rect x="3" y="3" width="18" height="14" rx="2" fill="#1e293b" stroke="url(#p-silver)" stroke-width="0.8"/>
            <path d="M6 7L9 10L6 13" stroke="#38bdf8" stroke-width="1.4" stroke-linecap="round"/>
            <line x1="11" y1="13" x2="16" y2="13" stroke="#38bdf8" stroke-width="1.4"/>
            <path d="M7 17L5 21H19L17 17" fill="#334155"/>
          </svg>
        </span>
        Editor
      </button>
      <button class="btn-layout-toggle" id="btn-mode-chat" onclick="setLayoutMode('chat')" title="AI Copilot Only">
        <span class="btn-phys-icon">
          <svg class="phys-icon" width="13" height="13" viewBox="0 0 24 24" fill="none">
            <rect x="8" y="4" width="8" height="11" rx="4" fill="url(#act-mic-steel)" stroke="#334155" stroke-width="0.7"/>
            <line x1="8" y1="8" x2="16" y2="8" stroke="#475569" stroke-width="0.6"/>
            <line x1="8" y1="11" x2="16" y2="11" stroke="#475569" stroke-width="0.6"/>
            <path d="M5.5 10C5.5 13.5 8.5 16.5 12 16.5C15.5 16.5 18.5 13.5 18.5 10" stroke="url(#p-brass)" stroke-width="1.4" stroke-linecap="round"/>
            <line x1="12" y1="16.5" x2="12" y2="20" stroke="url(#act-mic-steel)" stroke-width="1.6"/>
            <line x1="8.5" y1="20" x2="15.5" y2="20" stroke="url(#p-brass)" stroke-width="1.6"/>
          </svg>
        </span>
        Copilot
      </button>
    </div>
  </header>

  <!-- 2. MAIN WORKSPACE CONTAINER -->
  <div id="workspace-container">

    <!-- 2.1 ACTIVITY BAR -->
    <nav id="activity-bar">
      <!-- 1. Physical Archival Portfolio Binder -->
      <div class="activity-icon active" id="act-files" onclick="toggleSidebar('files')" title="Explorer (Projects & Workspace)">
        <svg class="phys-icon" width="22" height="22" viewBox="0 0 24 24" fill="none">
          <rect x="3" y="2" width="18" height="20" rx="2" fill="url(#act-binder-cov)" stroke="#1e293b" stroke-width="0.7"/>
          <line x1="7.5" y1="2" x2="7.5" y2="22" stroke="#94a3b8" stroke-width="0.8" stroke-dasharray="1.5 1.5"/>
          <circle cx="5" cy="5" r="1.2" fill="url(#p-brass)" stroke="#451a03" stroke-width="0.4"/>
          <circle cx="5" cy="12" r="1.2" fill="url(#p-brass)" stroke="#451a03" stroke-width="0.4"/>
          <circle cx="5" cy="19" r="1.2" fill="url(#p-brass)" stroke="#451a03" stroke-width="0.4"/>
          <path d="M21 5H22.5C23 5 23.5 5.5 23.5 6V8.5C23.5 9 23 9.5 22.5 9.5H21" fill="#f59e0b"/>
          <path d="M21 11H22.5C23 11 23.5 11.5 23.5 12V14.5C23.5 15 23 15.5 22.5 15.5H21" fill="#10b981"/>
          <rect x="10.5" y="8" width="7" height="8" rx="1" fill="#0f172a" stroke="url(#p-brass)" stroke-width="0.6"/>
          <line x1="12" y1="10.5" x2="16" y2="10.5" stroke="url(#p-brass)" stroke-width="0.6"/>
          <line x1="12" y1="12.5" x2="15" y2="12.5" stroke="url(#p-brass)" stroke-width="0.6"/>
        </svg>
      </div>

      <!-- 2. Physical Studio Ribbon Microphone -->
      <div class="activity-icon" id="act-chat" onclick="setLayoutMode('chat')" title="Anjiru AI Copilot">
        <svg class="phys-icon" width="22" height="22" viewBox="0 0 24 24" fill="none">
          <rect x="8" y="4" width="8" height="11" rx="4" fill="url(#act-mic-steel)" stroke="#334155" stroke-width="0.7"/>
          <rect x="8.5" y="4.5" width="7" height="6.5" rx="3.5" fill="url(#act-mic-grille)" stroke="#475569" stroke-width="0.5"/>
          <line x1="9" y1="7" x2="15" y2="7" stroke="#94a3b8" stroke-width="0.5"/>
          <line x1="9" y1="9" x2="15" y2="9" stroke="#94a3b8" stroke-width="0.5"/>
          <circle cx="12" cy="7.5" r="1.3" fill="#f59e0b" filter="drop-shadow(0 0 3px #f59e0b)"/>
          <path d="M5.5 9.5C5.5 13.5 8.5 16.5 12 16.5C15.5 16.5 18.5 13.5 18.5 9.5" stroke="url(#p-brass)" stroke-width="1.4" stroke-linecap="round"/>
          <circle cx="5.5" cy="9.5" r="1.2" fill="url(#p-brass)"/>
          <circle cx="18.5" cy="9.5" r="1.2" fill="url(#p-brass)"/>
          <line x1="12" y1="16.5" x2="12" y2="20.5" stroke="url(#act-mic-steel)" stroke-width="1.8" stroke-linecap="round"/>
          <path d="M8.5 20.5H15.5" stroke="url(#p-brass)" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
      </div>

      <!-- 3. Physical CRT Hardware Console -->
      <div class="activity-icon" id="act-terminal" onclick="toggleBottomTerminal()" title="Toggle Integrated Terminal (Ctrl+`)">
        <svg class="phys-icon" width="22" height="22" viewBox="0 0 24 24" fill="none">
          <rect x="2" y="3" width="20" height="15" rx="3" fill="url(#act-crt-chassis)" stroke="#1e293b" stroke-width="0.8"/>
          <circle cx="4" cy="5" r="0.7" fill="#64748b"/>
          <circle cx="20" cy="5" r="0.7" fill="#64748b"/>
          <rect x="4.5" y="5" width="15" height="10.5" rx="1.8" fill="#061811" stroke="#064e3b" stroke-width="0.7"/>
          <path d="M6.5 8L8.5 10L6.5 12" stroke="#34d399" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
          <rect x="10" y="11" width="3" height="1.2" fill="#34d399"/>
          <rect x="17.5" y="16.5" width="2.5" height="1" rx="0.5" fill="#f59e0b"/>
          <path d="M9 18L7.5 21H16.5L15 18" fill="#334155" stroke="#1e293b" stroke-width="0.6"/>
        </svg>
      </div>

      <!-- 4. Physical Machined Vernier Caliper -->
      <div class="activity-icon" onclick="openCommandPalette()" title="Command Palette (Ctrl+K)">
        <svg class="phys-icon" width="22" height="22" viewBox="0 0 24 24" fill="none">
          <rect x="2" y="8" width="20" height="4" rx="0.5" fill="url(#p-silver)" stroke="#475569" stroke-width="0.5"/>
          <line x1="5" y1="8" x2="5" y2="10" stroke="#334155" stroke-width="0.6"/>
          <line x1="7.5" y1="8" x2="7.5" y2="9.5" stroke="#334155" stroke-width="0.5"/>
          <line x1="10" y1="8" x2="10" y2="10" stroke="#334155" stroke-width="0.6"/>
          <line x1="12.5" y1="8" x2="12.5" y2="9.5" stroke="#334155" stroke-width="0.5"/>
          <line x1="15" y1="8" x2="15" y2="10" stroke="#334155" stroke-width="0.6"/>
          <path d="M2 4V16C2 17 3 17.5 4 16.5L5.5 12H2V4Z" fill="url(#p-silver)" stroke="#334155" stroke-width="0.5"/>
          <path d="M12 4V16C12 17 11 17.5 10 16.5L8.5 12H13.5V4H12Z" fill="url(#p-brass)" stroke="#78350f" stroke-width="0.5"/>
          <circle cx="12" cy="14" r="1.5" fill="url(#p-brass)" stroke="#78350f" stroke-width="0.5"/>
        </svg>
      </div>

      <!-- 5. Physical Optical Camera Lens Dial -->
      <div class="activity-icon" onclick="cycleTheme()" title="Cycle Theme Glow" style="margin-top: auto;">
        <svg class="phys-icon" width="22" height="22" viewBox="0 0 24 24" fill="none">
          <circle cx="12" cy="12" r="10" fill="url(#act-lens-ring)" stroke="#1e293b" stroke-width="0.8"/>
          <circle cx="12" cy="12" r="9" stroke="#94a3b8" stroke-width="0.6" stroke-dasharray="1.5 1.5"/>
          <circle cx="12" cy="12" r="6.8" fill="url(#act-lens-glass)"/>
          <path d="M7 8C8.5 6.5 11 6 13.5 6.5C10.5 7.5 9 10 9 13.5C7.5 12 7 9.5 7 8Z" fill="url(#act-lens-refl)" opacity="0.85"/>
          <circle cx="12" cy="12" r="2.5" fill="#090d16" stroke="url(#p-brass)" stroke-width="0.8"/>
        </svg>
      </div>
    </nav>

    <!-- 2.2 EXPLORER SIDEBAR (CLEAN ISOLATED USER WORKSPACE) -->
    <aside id="sidebar-panel" ondragover="handleDragOver(event)" ondragleave="handleDragLeave(event)" ondrop="handleDropFile(event)">
      <div class="sidebar-section-header">
        <span title="Isolated User Project Workspace">User Workspace</span>
        <div class="sidebar-actions">
          <!-- Physical New File: Paper & Fountain Pen -->
          <button class="btn-side-action" onclick="showInlineCreate('file')" title="New File (Inline)">
            <svg class="phys-icon" width="14" height="14" viewBox="0 0 24 24" fill="none">
              <path d="M4 3.5C4 2.7 4.7 2 5.5 2H13.5L18 6.5V20.5C18 21.3 17.3 22 16.5 22H5.5C4.7 22 4 21.3 4 20.5V3.5Z" fill="#f8fafc" stroke="#cbd5e1" stroke-width="0.8"/>
              <path d="M13 2L18 7H14.5C13.7 7 13 6.3 13 5.5V2Z" fill="#94a3b8"/>
              <!-- Fountain Pen -->
              <path d="M14 11L19 16L17 21L12 19L14 11Z" fill="url(#p-brass)" stroke="#78350f" stroke-width="0.5"/>
              <polygon points="12,19 11,22 13.5,21.5" fill="#0f172a"/>
            </svg>
          </button>
          <!-- Physical New Folder: Manila Folder Plus -->
          <button class="btn-side-action" onclick="showInlineCreate('folder')" title="New Folder (Inline)">
            <svg class="phys-icon" width="14" height="14" viewBox="0 0 24 24" fill="none">
              <path d="M2 5.5C2 4.4 2.9 3.5 4 3.5H9.2C9.8 3.5 10.4 3.8 10.8 4.2L12.5 6H20C21.1 6 22 6.9 22 8V18C22 19.1 21.1 20 20 20H4C2.9 20 2 19.1 2 18V5.5Z" fill="url(#p-fld-front)"/>
              <circle cx="16" cy="14" r="4.5" fill="#10b981" stroke="#064e3b" stroke-width="0.5"/>
              <path d="M16 11.5V16.5M13.5 14H18.5" stroke="#ffffff" stroke-width="1.2" stroke-linecap="round"/>
            </svg>
          </button>
          <!-- Physical Upload: In-Tray Inbox -->
          <button class="btn-side-action" onclick="triggerWorkspaceUpload()" title="Upload File to Workspace">
            <svg class="phys-icon" width="14" height="14" viewBox="0 0 24 24" fill="none">
              <path d="M3 14V19C3 20.1 3.9 21 5 21H19C20.1 21 21 20.1 21 19V14H17L15 17H9L7 14H3Z" fill="url(#p-silver)" stroke="#475569" stroke-width="0.8"/>
              <path d="M12 3V13M12 3L8 7M12 3L16 7" stroke="url(#p-brass)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <!-- Physical Refresh: Clockwork Gears -->
          <button class="btn-side-action" onclick="loadProjectFiles()" title="Refresh">
            <svg class="phys-icon" width="14" height="14" viewBox="0 0 24 24" fill="none">
              <circle cx="12" cy="12" r="8" stroke="url(#p-brass)" stroke-width="2" stroke-linecap="round" stroke-dasharray="32 12"/>
              <polygon points="12,2 15,5 12,8" fill="url(#p-brass)"/>
              <circle cx="12" cy="12" r="3" fill="#1e293b" stroke="url(#p-brass)" stroke-width="0.8"/>
            </svg>
          </button>
          <!-- Physical Clear: Drafting Eraser -->
          <button class="btn-side-action" onclick="confirmClearWorkspace()" title="Clear Workspace" style="color:#ef4444;">
            <svg class="phys-icon" width="14" height="14" viewBox="0 0 24 24" fill="none">
              <path d="M15 3L21 9L11 19L5 13L15 3Z" fill="#ef4444" stroke="#b91c1c" stroke-width="0.8"/>
              <path d="M5 13L2 16L8 22L11 19L5 13Z" fill="#cbd5e1" stroke="#64748b" stroke-width="0.8"/>
              <line x1="8" y1="22" x2="22" y2="22" stroke="#ef4444" stroke-width="1.2" stroke-linecap="round"/>
            </svg>
          </button>
        </div>
      </div>
      <input type="file" id="workspace-file-uploader" style="display:none;" onchange="handleWorkspaceUploadSelected(event)" multiple>

      <div class="file-tree-list" id="project-file-list">
        <!-- Rendered via JS: Clean empty state or real user files -->
      </div>
    </aside>

    <!-- 2.3 SPLIT PANES (CODE EDITOR + AI COPILOT) -->
    <main id="panes-wrapper">

      <!-- PANE A: CODE EDITOR -->
      <section id="editor-pane">
        <div class="editor-tabs-bar" id="editor-tabs-container">
          <!-- Dynamic Tabs -->
        </div>

        <div class="editor-toolbar">
          <div style="font-family: var(--font-mono); font-size: 11.5px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; max-width:280px;" id="editor-path-indicator">
            (No file open)
          </div>
          <div class="editor-toolbar-actions">
            <!-- Physical Run Code: Industrial Emerald Push Button -->
            <button class="btn-exec-run" onclick="runActiveEditorFile()" title="Run Code (Ctrl + Enter)">
              <span class="btn-phys-icon">
                <svg class="phys-icon" width="13" height="13" viewBox="0 0 24 24" fill="none">
                  <circle cx="12" cy="12" r="10.5" fill="url(#p-silver)" stroke="#334155" stroke-width="0.8"/>
                  <circle cx="12" cy="12" r="7.5" fill="url(#p-jewel-run)" stroke="#064e3b" stroke-width="0.6"/>
                  <polygon points="10,8.5 16,12 10,15.5" fill="#ffffff"/>
                </svg>
              </span>
              Run Code
            </button>
            <!-- Physical Save: 3.5-Inch Floppy Disk -->
            <button class="btn-editor-tool" onclick="saveActiveEditorFile()" title="Save File (Ctrl + S)">
              <span class="btn-phys-icon">
                <svg class="phys-icon" width="13" height="13" viewBox="0 0 24 24" fill="none">
                  <path d="M3 4C3 2.9 3.9 2 5 2H18L21 5V20C21 21.1 20.1 22 19 22H5C3.9 22 3 21.1 3 20V4Z" fill="url(#p-floppy-case)" stroke="#1e293b" stroke-width="0.7"/>
                  <rect x="7" y="2" width="9" height="7" rx="0.5" fill="url(#p-silver)" stroke="#475569" stroke-width="0.5"/>
                  <rect x="6" y="11" width="12" height="9" rx="1" fill="#f8fafc" stroke="#cbd5e1" stroke-width="0.5"/>
                  <line x1="8" y1="14" x2="16" y2="14" stroke="#0284c7" stroke-width="0.8"/>
                </svg>
              </span>
              Save
            </button>
            <!-- Physical Templates: Drafting Ruler Stencil -->
            <button class="btn-editor-tool" onclick="toggleTemplateMenu()" title="Insert Starter Code Template">
              <span class="btn-phys-icon">
                <svg class="phys-icon" width="13" height="13" viewBox="0 0 24 24" fill="none">
                  <rect x="2" y="5" width="20" height="14" rx="1.5" fill="url(#p-brass)" stroke="#78350f" stroke-width="0.7"/>
                  <line x1="5" y1="5" x2="5" y2="8" stroke="#451a03" stroke-width="0.8"/>
                  <line x1="8" y1="5" x2="8" y2="7" stroke="#451a03" stroke-width="0.6"/>
                  <line x1="11" y1="5" x2="11" y2="8" stroke="#451a03" stroke-width="0.8"/>
                  <line x1="14" y1="5" x2="14" y2="7" stroke="#451a03" stroke-width="0.6"/>
                  <line x1="17" y1="5" x2="17" y2="8" stroke="#451a03" stroke-width="0.8"/>
                  <circle cx="7" cy="13" r="2" fill="#0f172a"/>
                  <rect x="12" y="11" width="6" height="4" rx="0.5" fill="#0f172a"/>
                </svg>
              </span>
              Templates ▾
            </button>
            <!-- Physical Auto-Debug: Stainless Wrench & Screwdriver -->
            <button class="btn-editor-tool" onclick="askAiToDebugEditor()" title="Ask Anjiru to Debug">
              <span class="btn-phys-icon">
                <svg class="phys-icon" width="13" height="13" viewBox="0 0 24 24" fill="none">
                  <path d="M14.7 6.3C14.3 6.7 14.3 7.3 14.7 7.7L16.3 9.3C16.7 9.7 17.3 9.7 17.7 9.3L20.8 6.2C21.4 7.2 21.3 8.5 20.4 9.4C19.5 10.3 18.2 10.4 17.2 9.8L8.6 18.4C8.2 18.8 7.6 18.8 7.2 18.4L5.6 16.8C5.2 16.4 5.2 15.8 5.6 15.4L14.2 6.8C13.6 5.8 13.7 4.5 14.6 3.6C15.5 2.7 16.8 2.6 17.8 3.2L14.7 6.3Z" fill="url(#p-silver)" stroke="#334155" stroke-width="0.6"/>
                </svg>
              </span>
              Auto-Debug
            </button>
          </div>
        </div>

        <!-- Floating Template Dropdown -->
        <div id="template-dropdown-menu">
          <div class="template-item" onclick="insertCodeTemplate('mcculloch')">
            <span class="template-title" style="display:flex; align-items:center; gap:8px;">
              <svg class="phys-icon" width="14" height="14" viewBox="0 0 24 24" fill="none">
                <path d="M7 6C7 3.5 9 2 12 2C15 2 17 3.5 17 6V17H7V6Z" fill="#38bdf8" fill-opacity="0.2" stroke="rgba(255,255,255,0.4)" stroke-width="0.8"/>
                <rect x="6" y="17" width="12" height="4" rx="1" fill="#1e293b" stroke="#334155" stroke-width="0.6"/>
                <line x1="8" y1="21" x2="8" y2="23.5" stroke="url(#p-brass)" stroke-width="1.2"/>
                <line x1="12" y1="21" x2="12" y2="23.5" stroke="url(#p-brass)" stroke-width="1.2"/>
                <line x1="16" y1="21" x2="16" y2="23.5" stroke="url(#p-brass)" stroke-width="1.2"/>
                <path class="phys-filament" d="M11 14V9L12 7.5L13 9V14" stroke="#f59e0b" stroke-width="1" stroke-linecap="round"/>
              </svg>
              McCulloch-Pitts Neuron (1943)
            </span>
            <span class="template-desc">Threshold Logic Unit & Boolean calculus</span>
          </div>
          <div class="template-item" onclick="insertCodeTemplate('attention')">
            <span class="template-title" style="display:flex; align-items:center; gap:8px;">
              <svg class="phys-icon" width="14" height="14" viewBox="0 0 24 24" fill="none">
                <rect x="5" y="5" width="14" height="14" rx="2" fill="#090d16" stroke="url(#p-silver)" stroke-width="0.8"/>
                <rect x="8" y="8" width="8" height="8" rx="1" fill="#1e293b" stroke="url(#p-brass)" stroke-width="0.6"/>
                <line x1="2" y1="9" x2="5" y2="9" stroke="url(#p-brass)" stroke-width="0.8"/>
                <line x1="2" y1="15" x2="5" y2="15" stroke="url(#p-brass)" stroke-width="0.8"/>
                <line x1="19" y1="9" x2="22" y2="9" stroke="url(#p-brass)" stroke-width="0.8"/>
                <line x1="19" y1="15" x2="22" y2="15" stroke="url(#p-brass)" stroke-width="0.8"/>
                <circle cx="12" cy="12" r="1.5" fill="#10b981"/>
              </svg>
              Scaled Dot-Product Attention
            </span>
            <span class="template-desc">Multi-Head attention layer & softmax</span>
          </div>
          <div class="template-item" onclick="insertCodeTemplate('plot')">
            <span class="template-title" style="display:flex; align-items:center; gap:8px;">
              <svg class="phys-icon" width="14" height="14" viewBox="0 0 24 24" fill="none">
                <rect x="2" y="3" width="20" height="18" rx="3" fill="#1e293b" stroke="url(#p-silver)" stroke-width="0.8"/>
                <rect x="4.5" y="5.5" width="15" height="13" rx="1.5" fill="#042f2e" stroke="#134e4a" stroke-width="0.6"/>
                <path class="phys-oscilloscope-trace" d="M5.5 14L8.5 13L10.5 7L13 17L15.5 11L18.5 12" stroke="#34d399" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              Matplotlib Dark Telemetry Plot
            </span>
            <span class="template-desc">Vector plotting engine with loss curves</span>
          </div>
          <div class="template-item" onclick="insertCodeTemplate('entropy')">
            <span class="template-title" style="display:flex; align-items:center; gap:8px;">
              <svg class="phys-icon" width="14" height="14" viewBox="0 0 24 24" fill="none">
                <rect x="2" y="7" width="20" height="10" rx="1" fill="#fef08a" stroke="url(#p-brass)" stroke-width="0.8"/>
                <line x1="3" y1="10" x2="21" y2="10" stroke="#78350f" stroke-width="0.5"/>
                <line x1="3" y1="14" x2="21" y2="14" stroke="#78350f" stroke-width="0.5"/>
                <rect x="9.5" y="5.5" width="5" height="13" rx="0.5" fill="#f8fafc" fill-opacity="0.35" stroke="url(#p-silver)" stroke-width="0.8"/>
                <line x1="12" y1="5.5" x2="12" y2="18.5" stroke="#ef4444" stroke-width="0.8"/>
              </svg>
              Shannon Entropy Calculator
            </span>
            <span class="template-desc">Information theory & channel compression</span>
          </div>
          <div class="template-item" onclick="insertCodeTemplate('threading')">
            <span class="template-title" style="display:flex; align-items:center; gap:8px;">
              <svg class="phys-icon" width="14" height="14" viewBox="0 0 24 24" fill="none">
                <g class="phys-gear-rotate">
                  <circle cx="10" cy="11" r="5" fill="#ca8a04" stroke="url(#p-brass)" stroke-width="0.8"/>
                  <circle cx="10" cy="11" r="2" fill="#0f172a"/>
                  <path d="M10 4V6M10 16V18M3 11H5M15 11H17" stroke="url(#p-brass)" stroke-width="1.5" stroke-linecap="round"/>
                </g>
                <g class="phys-gear-counter">
                  <circle cx="16" cy="16" r="3.5" fill="#64748b" stroke="url(#p-silver)" stroke-width="0.6"/>
                  <circle cx="16" cy="16" r="1.2" fill="#0f172a"/>
                </g>
              </svg>
              Concurrent Worker Pipeline
            </span>
            <span class="template-desc">Multi-threaded queue worker pool</span>
          </div>
        </div>

        <div id="monaco-editor-container"></div>
        <textarea id="fallback-editor" spellcheck="false"></textarea>

        <!-- Media viewer for binary files (Audio/Video/Image) instead of corrupt raw bytes in Monaco! -->
        <div id="editor-media-preview">
          <div id="media-preview-content"></div>
        </div>
      </section>

      <!-- PANE B: ANJIRU AI COPILOT -->
      <section id="ai-pane">
        <div class="ai-pane-header">
          <div class="ai-header-brand">
            <span>Anjiru.AI</span>
            <span class="badge-eco shimmer-badge">72.4% Token Economy</span>
          </div>
          <div style="font-size: 11px; color: var(--text-muted);">
            Sovereign African Foundation Intelligence
          </div>
        </div>

        <div id="chat-viewport">
          <div class="empty-chat-welcome" id="empty-welcome">
            <img src="/static/angel_gabriel.png" alt="Archangel Gabriel Silhouette" style="width: 96px; height: 96px; border-radius: 14px; border: 1px solid rgba(16,185,129,0.35); box-shadow: 0 0 35px rgba(16,185,129,0.2); object-fit: cover; margin-bottom: 14px;" />
            <div class="empty-title">Anjiru Superintelligence</div>
            <div class="empty-sub">
              Ready to code, refactor, and build. Ask anything or describe your task below.
            </div>
          </div>
        </div>

        <!-- AI INPUT DOCK (CLEAN ANTIGRAVITY STYLE) -->
        <div id="ai-input-dock">

          <div class="ai-input-box">
            <textarea id="prompt-input" placeholder="Ask Anjiru.AI to code, debug, analyze... (Enter to send, Shift+Enter for newline)"></textarea>
            <div class="input-dock-controls">
              <div class="input-left-controls">
                <button class="btn-circle-action" title="New Workspace File" onclick="showInlineCreate('file')">+</button>
                <div class="model-tag" style="display:inline-flex; align-items:center; gap:6px; background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.08); border-radius:14px; padding:3px 10px; font-size:11px; color:#cbd5e1; font-weight:500;">
                  <span style="width:6px; height:6px; border-radius:50%; background:var(--accent-emerald);"></span>
                  <span>Anjiru Model</span>
                </div>
                <!-- Physical Broadcast Ribbon Microphone -->
                <button class="btn-circle-action" id="btn-mic-input" onclick="toggleSpeech()" title="Voice Input (sw-KE)">
                  <svg class="phys-icon" width="13" height="13" viewBox="0 0 24 24" fill="none">
                    <rect x="8" y="3" width="8" height="11" rx="4" fill="url(#p-silver)" stroke="#334155" stroke-width="0.7"/>
                    <line x1="8" y1="7" x2="16" y2="7" stroke="#475569" stroke-width="0.6"/>
                    <line x1="8" y1="10" x2="16" y2="10" stroke="#475569" stroke-width="0.6"/>
                    <path d="M5.5 9C5.5 13 8.5 16 12 16C15.5 16 18.5 13 18.5 9" stroke="url(#p-brass)" stroke-width="1.4" stroke-linecap="round"/>
                    <line x1="12" y1="16" x2="12" y2="21" stroke="url(#p-silver)" stroke-width="1.6" stroke-linecap="round"/>
                    <path d="M9 21H15" stroke="url(#p-brass)" stroke-width="1.6" stroke-linecap="round"/>
                  </svg>
                </button>
              </div>
              <!-- Physical Plunger Launch Button -->
              <button class="btn-send-round" onclick="submitChatPrompt()" title="Send Prompt (Ctrl + Enter)">
                <svg class="phys-icon" width="14" height="14" viewBox="0 0 24 24" fill="none">
                  <path d="M5 12H19M19 12L13 6M19 12L13 18" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            </div>
          </div>
        </div>
      </section>

    </main>
  </div>

  <!-- 3. BOTTOM PANEL: INTEGRATED TERMINAL -->
  <footer id="bottom-panel">
    <div class="bottom-panel-header">
      <div class="bottom-tabs">
        <button class="bottom-tab-btn active" id="tab-terminal-btn" onclick="switchBottomTab('terminal')">
          <span class="btn-phys-icon">
            <svg class="phys-icon" width="12" height="12" viewBox="0 0 24 24" fill="none">
              <rect x="2" y="3" width="20" height="15" rx="2" fill="#1e293b" stroke="url(#p-silver)" stroke-width="0.8"/>
              <path d="M6 7L9 10L6 13" stroke="#34d399" stroke-width="1.4" stroke-linecap="round"/>
              <line x1="11" y1="13" x2="16" y2="13" stroke="#34d399" stroke-width="1.4"/>
            </svg>
          </span>
          Terminal
        </button>
        <button class="bottom-tab-btn" id="tab-output-btn" onclick="switchBottomTab('output')">
          <span class="btn-phys-icon">
            <svg class="phys-icon" width="12" height="12" viewBox="0 0 24 24" fill="none">
              <rect x="4" y="2" width="16" height="20" rx="1.5" fill="#f8fafc" stroke="#cbd5e1" stroke-width="0.8"/>
              <line x1="7" y1="7" x2="17" y2="7" stroke="#94a3b8" stroke-width="1"/>
              <line x1="7" y1="11" x2="17" y2="11" stroke="#94a3b8" stroke-width="1"/>
              <line x1="7" y1="15" x2="13" y2="15" stroke="#94a3b8" stroke-width="1"/>
            </svg>
          </span>
          Output
        </button>
        <button class="bottom-tab-btn" id="tab-problems-btn" onclick="switchBottomTab('problems')">
          <span class="btn-phys-icon">
            <svg class="phys-icon" width="12" height="12" viewBox="0 0 24 24" fill="none">
              <circle cx="12" cy="12" r="9" fill="#f59e0b" fill-opacity="0.2" stroke="#f59e0b" stroke-width="1.2"/>
              <line x1="12" y1="7" x2="12" y2="13" stroke="#f59e0b" stroke-width="1.5" stroke-linecap="round"/>
              <circle cx="12" cy="16.5" r="1" fill="#f59e0b"/>
            </svg>
          </span>
          Problems
        </button>
        <button class="bottom-tab-btn" id="tab-tracker-btn" onclick="switchBottomTab('tracker')">
          <span class="btn-phys-icon">
            <svg class="phys-icon" width="12" height="12" viewBox="0 0 24 24" fill="none">
              <rect x="4" y="4" width="16" height="18" rx="2" fill="#1e293b" stroke="url(#p-silver)" stroke-width="0.8"/>
              <rect x="8" y="2" width="8" height="4" rx="1" fill="url(#p-brass)" stroke="#78350f" stroke-width="0.5"/>
              <line x1="7" y1="10" x2="17" y2="10" stroke="#38bdf8" stroke-width="1"/>
              <line x1="7" y1="14" x2="17" y2="14" stroke="#38bdf8" stroke-width="1"/>
            </svg>
          </span>
          Mpango wa Kazi
        </button>
      </div>
      <div class="bottom-actions">
        <button class="btn-side-action" onclick="triggerRunUnitTests()" title="Run Tests">
          <span class="btn-phys-icon">
            <svg class="phys-icon" width="12" height="12" viewBox="0 0 24 24" fill="none">
              <rect x="5" y="10" width="14" height="11" rx="2" fill="#0f172a" stroke="url(#p-silver)" stroke-width="0.8"/>
              <rect x="7" y="3" width="3" height="9" rx="1" fill="#38bdf8" stroke="#0284c7" stroke-width="0.6"/>
              <rect x="14" y="5" width="3" height="7" rx="1" fill="#10b981" stroke="#047857" stroke-width="0.6"/>
            </svg>
          </span>
          Tests
        </button>
        <button class="btn-side-action" onclick="clearTerminalOutput()" title="Clear">
          <span class="btn-phys-icon">
            <svg class="phys-icon" width="12" height="12" viewBox="0 0 24 24" fill="none">
              <path d="M15 3L21 9L11 19L5 13L15 3Z" fill="#ef4444" stroke="#b91c1c" stroke-width="0.8"/>
              <line x1="8" y1="22" x2="22" y2="22" stroke="#cbd5e1" stroke-width="1.2" stroke-linecap="round"/>
            </svg>
          </span>
          Clear
        </button>
        <button class="btn-side-action" onclick="toggleBottomTerminal()" title="Toggle Panel">
          <svg class="phys-icon" width="10" height="10" viewBox="0 0 20 20" fill="none">
            <circle cx="10" cy="10" r="8" fill="#1e293b" stroke="#475569" stroke-width="0.8"/>
            <path d="M7 7L13 13M13 7L7 13" stroke="#94a3b8" stroke-width="1.4" stroke-linecap="round"/>
          </svg>
        </button>
      </div>
    </div>
    <div id="panel-tab-terminal" style="display:flex; flex-direction:column; flex:1; min-height:0;">
      <div class="terminal-output-box" id="terminal-screen">Anjiru.AI Integrated Execution Shell Ready.
Running in workspace/user_projects/ directory.
Type Python statements or click [▶ Run Code] to execute.</div>
      <div class="terminal-input-row">
        <span class="terminal-prompt-char">&gt;</span>
        <input type="text" class="terminal-quick-input" id="terminal-cli-input" placeholder="Type python code and press Enter..." onkeydown="handleTerminalEnter(event)">
      </div>
    </div>

    <div id="panel-tab-output" class="terminal-output-box" style="display:none;">[Anjiru Output Log Console]
Ready. Workspace logs, compiler stdout/stderr streams, and server diagnostics will render here.</div>

    <div id="panel-tab-problems" class="terminal-output-box" style="display:none; color: #fbbf24;">[Anjiru Diagnostics & Self-Healing Console]
Zero compiler or syntax errors detected in workspace. Clean execution pipeline.</div>

    <div id="panel-tab-tracker" class="task-tracker-container">
      <div class="tracker-header-card">
        <div style="display:flex; align-items:center; gap:8px;">
          <span id="tracker-active-icon" style="display:inline-flex;">
            <svg class="phys-icon" width="20" height="20" viewBox="0 0 24 24" fill="none">
              <path d="M4 3.5C4 2.7 4.7 2 5.5 2H15.5L20 6.5V20.5C20 21.3 19.3 22 18.5 22H5.5C4.7 22 4 21.3 4 20.5V3.5Z" fill="url(#p-paper-py)" stroke="#1e293b" stroke-width="0.5"/>
              <text x="12" y="16" font-family="'JetBrains Mono', monospace" font-size="5" font-weight="900" fill="#ffffff" text-anchor="middle">PY</text>
            </svg>
          </span>
          <div>
            <div style="font-weight:700; color:#fff;" id="tracker-active-name">Mazingira ya Msimbo (Active Stack)</div>
            <div style="font-size:10.5px; color:var(--text-muted);" id="tracker-active-tools">Python 3.12 • Node 24 • Docker Isolated Sandbox Ready</div>
          </div>
        </div>
        <div style="display:flex; gap:6px;">
          <button class="btn-side-action" onclick="refreshPolyglotStack(true)" title="Sasisha Mazingira">
            <span class="btn-phys-icon">
              <svg class="phys-icon" width="12" height="12" viewBox="0 0 24 24" fill="none">
                <circle cx="12" cy="12" r="8" stroke="url(#p-brass)" stroke-width="2" stroke-linecap="round" stroke-dasharray="32 12"/>
                <polygon points="12,2 15,5 12,8" fill="url(#p-brass)"/>
                <circle cx="12" cy="12" r="3" fill="#1e293b" stroke="url(#p-brass)" stroke-width="0.8"/>
              </svg>
            </span>
            Sasisha
          </button>
          <button class="btn-side-action" onclick="fetchAndDisplayRepoMap()" title="Tengeneza Ramani ya Msimbo">
            <span class="btn-phys-icon">
              <svg class="phys-icon" width="12" height="12" viewBox="0 0 24 24" fill="none">
                <polygon points="3,5 9,2 9,19 3,22" fill="#fef9c3" stroke="url(#p-brass)" stroke-width="0.6"/>
                <polygon points="9,2 15,5 15,22 9,19" fill="#fef08a" stroke="url(#p-brass)" stroke-width="0.6"/>
                <polygon points="15,5 21,2 21,19 15,22" fill="#fde047" stroke="url(#p-brass)" stroke-width="0.6"/>
              </svg>
            </span>
            Repo Map
          </button>
        </div>
      </div>

      <div class="tracker-steps-grid">
        <div class="tracker-step-card active" id="track-step-1">
          <div class="tracker-step-header">
            <span>1. Uchunguzi wa Mazingira</span>
            <span class="tracker-chip chip-done" id="chip-step-1">Imekamilika</span>
          </div>
          <div class="tracker-step-desc">Gundua runtimes (Python, Node, Rust, Docker) na muundo wa mradi kiotomatiki.</div>
        </div>

        <div class="tracker-step-card" id="track-step-2">
          <div class="tracker-step-header">
            <span>2. Mpango wa Usanifu</span>
            <span class="tracker-chip chip-pending" id="chip-step-2">Inasubiri</span>
          </div>
          <div class="tracker-step-desc">Andaa ramani ya JSON ya hatua nyingi [EXECUTION_KERNEL_PLAN] kabla ya kuanza.</div>
        </div>

        <div class="tracker-step-card" id="track-step-3">
          <div class="tracker-step-header">
            <span>3. Ujenzi na Marekebisho</span>
            <span class="tracker-chip chip-pending" id="chip-step-3">Inasubiri</span>
          </div>
          <div class="tracker-step-desc">Tekeleza block diffing (Aider-style) na utengenezaji wa mafaili mengi salama.</div>
        </div>

        <div class="tracker-step-card" id="track-step-4">
          <div class="tracker-step-header">
            <span>4. Jaribio la Sandbox</span>
            <span class="tracker-chip chip-pending" id="chip-step-4">Inasubiri</span>
          </div>
          <div class="tracker-step-desc">Fanya majaribio ndani ya kontena la Docker au isolated host jail kuzuia makosa.</div>
        </div>

        <div class="tracker-step-card" id="track-step-5">
          <div class="tracker-step-header">
            <span>5. Kujitibu Kiotomatiki</span>
            <span class="tracker-chip chip-healed" id="chip-step-5">Tayari</span>
          </div>
          <div class="tracker-step-desc">Nasa compiler traces (Rust, Go, Python, Node) na ujitibu bila kusita.</div>
        </div>
      </div>
    </div>
  </footer>

  <!-- 4. BOTTOM STATUS BAR (CLEAN, NO OVERLAP) -->
  <div id="status-bar">
    <div class="status-left">
      <div class="status-active-badge">
        <svg class="phys-icon phys-lamp-active" width="12" height="12" viewBox="0 0 24 24" fill="none">
          <circle cx="12" cy="12" r="10.5" fill="url(#p-silver)" stroke="#334155" stroke-width="0.8"/>
          <circle cx="12" cy="12" r="7" fill="url(#p-jewel-run)"/>
          <circle cx="12" cy="12" r="3" fill="#a7f3d0" filter="drop-shadow(0 0 3px #10b981)"/>
          <path d="M8 8.5C9.5 7 11.5 6.5 13.5 7" stroke="rgba(255,255,255,0.7)" stroke-width="1" stroke-linecap="round"/>
        </svg>
        <span>Anjiru Online</span>
      </div>
      <span>•</span>
      <span id="stat-latency" style="display:inline-flex; align-items:center; gap:4px;">
        <svg class="phys-icon" width="12" height="12" viewBox="0 0 24 24" fill="none">
          <rect x="2" y="3" width="20" height="18" rx="2" fill="#0f172a" stroke="url(#p-silver)" stroke-width="0.8"/>
          <path d="M4 12H8L10 6L14 18L16 12H20" stroke="#38bdf8" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span id="stat-latency-val">0.4ms</span>
      </span>
      <span>•</span>
      <span id="stat-cpu" style="display:inline-flex; align-items:center; gap:4px;">
        <svg class="phys-icon" width="12" height="12" viewBox="0 0 24 24" fill="none">
          <rect x="2" y="4" width="20" height="16" rx="2" fill="#1e293b" stroke="#334155" stroke-width="0.8"/>
          <path d="M5 14C7 9 17 9 19 14" stroke="#94a3b8" stroke-width="0.8" stroke-dasharray="1 1"/>
          <path d="M15 10C17 11 19 14 19 14" stroke="#ef4444" stroke-width="1.2"/>
          <circle cx="12" cy="16" r="1.5" fill="url(#p-brass)"/>
          <line class="phys-meter-needle" x1="12" y1="16" x2="16" y2="8" stroke="#f59e0b" stroke-width="1.2" stroke-linecap="round"/>
        </svg>
        <span id="stat-cpu-val">1.8% CPU</span>
      </span>
      <span>•</span>
      <span id="stat-ram" style="display:inline-flex; align-items:center; gap:4px;">
        <svg class="phys-icon" width="12" height="12" viewBox="0 0 24 24" fill="none">
          <rect x="5" y="4" width="14" height="16" rx="1.5" fill="#090d16" stroke="#334155" stroke-width="0.8"/>
          <circle cx="12" cy="6" r="1" fill="#1e293b"/>
          <line x1="2" y1="7" x2="5" y2="7" stroke="url(#p-brass)" stroke-width="1.2"/>
          <line x1="2" y1="11" x2="5" y2="11" stroke="url(#p-brass)" stroke-width="1.2"/>
          <line x1="2" y1="15" x2="5" y2="15" stroke="url(#p-brass)" stroke-width="1.2"/>
          <line x1="19" y1="7" x2="22" y2="7" stroke="url(#p-brass)" stroke-width="1.2"/>
          <line x1="19" y1="11" x2="22" y2="11" stroke="url(#p-brass)" stroke-width="1.2"/>
          <line x1="19" y1="15" x2="22" y2="15" stroke="url(#p-brass)" stroke-width="1.2"/>
          <text x="12" y="13.5" font-family="'JetBrains Mono', monospace" font-size="3.2" fill="#94a3b8" text-anchor="middle">RAM</text>
        </svg>
        <span id="stat-ram-val">56.8MB</span>
      </span>
      <span>•</span>
      <span id="stat-files" style="display:inline-flex; align-items:center; gap:4px;">
        <svg class="phys-icon" width="12" height="12" viewBox="0 0 24 24" fill="none">
          <rect x="3" y="6" width="18" height="14" rx="1.5" fill="url(#p-fld-back)"/>
          <rect x="4" y="4" width="16" height="14" rx="1.5" fill="url(#p-fld-front)"/>
          <line x1="7" y1="8" x2="17" y2="8" stroke="rgba(255,255,255,0.4)" stroke-width="0.8"/>
        </svg>
        <span id="stat-files-val">0 Files</span>
      </span>
      <span>•</span>
      <span style="color: var(--accent-emerald);" class="shimmer-badge">72.4% Economy</span>
      <span>•</span>
      <span id="local-neural-badge" style="cursor: pointer; display: inline-flex; align-items: center; gap: 5px; padding: 2px 8px; border-radius: 12px; background: rgba(148,163,184,0.1); border: 1px solid rgba(148,163,184,0.25); color: #94a3b8; font-size: 11px;" onclick="openNeuralEngineModal()" title="Local Offline Neural Engine Status (Ollama / GGUF)">
        <span id="local-neural-dot" style="display:inline-flex;">
          <svg class="phys-icon" width="8" height="8" viewBox="0 0 16 16" fill="none">
            <circle cx="8" cy="8" r="7" fill="url(#p-silver)" stroke="#475569" stroke-width="0.8"/>
            <circle id="local-neural-lamp-core" cx="8" cy="8" r="4" fill="#94a3b8"/>
          </svg>
        </span>
