        <svg class="phys-icon" width="12" height="12" viewBox="0 0 24 24" fill="none">
          <circle cx="12" cy="12" r="10" fill="url(#p-brass)" stroke="#78350f" stroke-width="0.8"/>
          <circle cx="12" cy="12" r="8.5" stroke="#78350f" stroke-width="0.5" stroke-dasharray="1 1"/>
          <text x="12" y="15" font-family="'JetBrains Mono', monospace" font-size="7" font-weight="900" fill="#451a03" text-anchor="middle">EN</text>
        </svg>
        <span>English</span>
      </span>
    </div>
  </div>

  <!-- 5. COMMAND PALETTE MODAL (CTRL + K) -->
  <div class="modal-overlay" id="cmd-palette-modal" onclick="closePaletteIfOverlay(event)">
    <div class="palette-box">
      <div class="palette-input-wrap">
        <span class="btn-phys-icon">
          <svg class="phys-icon" width="16" height="16" viewBox="0 0 24 24" fill="none">
            <rect x="2" y="9" width="20" height="3.5" rx="0.5" fill="url(#p-silver)" stroke="#475569" stroke-width="0.5"/>
            <line x1="5" y1="9" x2="5" y2="11" stroke="#334155" stroke-width="0.6"/>
            <line x1="8" y1="9" x2="8" y2="10.5" stroke="#334155" stroke-width="0.5"/>
            <line x1="11" y1="9" x2="11" y2="11" stroke="#334155" stroke-width="0.6"/>
            <path d="M2 5V17C2 18 3 18.5 4 17.5L5.5 12.5H2V5Z" fill="url(#p-silver)" stroke="#334155" stroke-width="0.5"/>
            <path d="M12 5V17C12 18 11 18.5 10 17.5L8.5 12.5H13.5V5H12Z" fill="url(#p-brass)" stroke="#78350f" stroke-width="0.5"/>
          </svg>
        </span>
        <input type="text" class="palette-input" id="cmd-palette-input" placeholder="Type a command or search action... (↑ ↓ Enter)" oninput="filterPalette(event)" onkeydown="navigatePalette(event)">
        <kbd class="key-hint">ESC</kbd>
      </div>
      <div class="palette-list" id="cmd-palette-list">
        <!-- Injected via JS -->
      </div>
    </div>
  </div>

  <!-- 6. QUICK OPEN FILE MODAL (CTRL + P) -->
  <div class="modal-overlay" id="quick-open-modal" onclick="closeQuickOpenIfOverlay(event)">
    <div class="palette-box">
      <div class="palette-input-wrap">
        <span class="btn-phys-icon">
          <svg class="phys-icon" width="16" height="16" viewBox="0 0 24 24" fill="none">
            <path d="M2 5.5C2 4.4 2.9 3.5 4 3.5H9.2C9.8 3.5 10.4 3.8 10.8 4.2L12.5 6H20C21.1 6 22 6.9 22 8V18C22 19.1 21.1 20 20 20H4C2.9 20 2 19.1 2 18V5.5Z" fill="url(#p-fld-back)"/>
            <path class="phys-folder-flap" d="M2 9.5C2 8.4 2.9 7.5 4 7.5H20C21.1 7.5 22 8.4 22 9.5V18C22 19.1 21.1 20 20 20H4C2.9 20 2 19.1 2 18V9.5Z" fill="url(#p-fld-front)"/>
          </svg>
        </span>
        <input type="text" class="palette-input" id="quick-open-input" placeholder="Search user workspace files... (↑ ↓ Enter)" oninput="filterQuickOpen(event)" onkeydown="navigateQuickOpen(event)">
        <kbd class="key-hint">ESC</kbd>
      </div>
      <div class="palette-list" id="quick-open-list">
        <!-- Injected via JS -->
      </div>
    </div>
  </div>

  <!-- 7. CUSTOM CONFIRMATION DIALOG (ZERO BROWSER POPUPS) -->
  <div class="modal-overlay" id="confirm-dialog-modal">
    <div class="confirm-box">
      <div class="confirm-title" id="confirm-modal-title">Confirm Action</div>
      <div class="confirm-msg" id="confirm-modal-msg">Are you sure?</div>
      <div class="confirm-actions">
        <button class="btn-layout-toggle" onclick="closeConfirmModal(false)">Cancel</button>
        <button class="btn-exec-run" id="confirm-modal-ok-btn" style="background:#ef4444; border-color:#ef4444; color:#fff;" onclick="closeConfirmModal(true)">Confirm</button>
      </div>
    </div>
  </div>

  <!-- 8. LOCAL NEURAL ENGINE MODAL -->
  <div class="modal-overlay" id="neural-engine-modal" onclick="closeNeuralModalIfOverlay(event)">
    <div class="palette-box" style="width: 580px; padding: 20px; gap: 14px; background: #0c1017; border: 1px solid var(--accent-glow);">
      <div style="display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--border-color); padding-bottom: 12px;">
        <div style="display: flex; align-items: center; gap: 8px; font-weight: 700; font-size: 14px; color: #f8fafc;">
          <svg class="phys-icon" width="18" height="18" viewBox="0 0 24 24" fill="none">
            <rect x="3" y="3" width="18" height="18" rx="2" fill="#1e293b" stroke="url(#p-silver)" stroke-width="0.8"/>
            <rect x="6.5" y="6.5" width="11" height="11" rx="1" fill="#090d16" stroke="url(#p-brass)" stroke-width="0.75"/>
            <text x="12" y="13.2" font-family="'JetBrains Mono', monospace" font-size="3.5" font-weight="900" fill="url(#p-brass)" text-anchor="middle">CPU</text>
            <polygon points="4,4 7,4 4,7" fill="url(#p-brass)"/>
          </svg>
          <span>Sovereign Local Offline Neural Engine</span>
        </div>
        <button style="background: transparent; border: none; color: var(--text-muted); cursor: pointer;" onclick="closeNeuralModal()">
          <svg class="phys-icon" width="12" height="12" viewBox="0 0 20 20" fill="none">
            <circle cx="10" cy="10" r="8" fill="#1e293b" stroke="#475569" stroke-width="0.8"/>
            <path d="M7 7L13 13M13 7L7 13" stroke="#94a3b8" stroke-width="1.4" stroke-linecap="round"/>
          </svg>
        </button>
      </div>

      <div id="neural-modal-content" style="display: flex; flex-direction: column; gap: 12px; font-size: 12.5px; color: #cbd5e1; line-height: 1.5;">
        <!-- Populated dynamically via JS -->
      </div>
    </div>
  </div>

