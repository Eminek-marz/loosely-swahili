        <path d="M12 5V17C12 18 11 18.5 10 17.5L8.5 12.5H13.5V5H12Z" fill="url(#p-brass)" stroke="#78350f" stroke-width="0.5"/>
        <circle cx="12" cy="15" r="1.2" fill="url(#p-brass)" stroke="#78350f" stroke-width="0.4"/>
      </svg>`,

      upload: `<svg class="phys-icon" width="16" height="16" viewBox="0 0 24 24" fill="none">
        <path d="M3 14V19C3 20.1 3.9 21 5 21H19C20.1 21 21 20.1 21 19V14H17L15 17H9L7 14H3Z" fill="url(#p-silver)" stroke="#475569" stroke-width="0.8"/>
        <path d="M12 3V13M12 3L8 7M12 3L16 7" stroke="url(#p-brass)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>`,

      newFile: `<svg class="phys-icon" width="16" height="16" viewBox="0 0 24 24" fill="none">
        <path d="M4 3.5C4 2.7 4.7 2 5.5 2H13.5L18 6.5V20.5C18 21.3 17.3 22 16.5 22H5.5C4.7 22 4 21.3 4 20.5V3.5Z" fill="#f8fafc" stroke="#cbd5e1" stroke-width="0.8"/>
        <path d="M13 2L18 7H14.5C13.7 7 13 6.3 13 5.5V2Z" fill="#94a3b8"/>
        <path d="M14 11L19 16L17 21L12 19L14 11Z" fill="url(#p-brass)" stroke="#78350f" stroke-width="0.5"/>
        <polygon points="12,19 11,22 13.5,21.5" fill="#0f172a"/>
      </svg>`
    };

    function getPhysicalFileIcon(item) {
      if (!item) return PHYSICAL_ICONS.doc;
      if (item.is_dir) return PHYSICAL_ICONS.folder;
      const ext = (item.ext || (item.path && item.path.includes('.') ? '.' + item.path.split('.').pop() : '')).toLowerCase();
      if (ext === '.py') return PHYSICAL_ICONS.py;
      if (ext === '.rs') return PHYSICAL_ICONS.rs;
      if (ext === '.ts' || ext === '.tsx') return PHYSICAL_ICONS.ts;
      if (ext === '.js' || ext === '.jsx' || ext === '.mjs') return PHYSICAL_ICONS.js;
      if (ext === '.md' || ext === '.txt') return PHYSICAL_ICONS.md;
      if (ext === '.toml' || ext === '.yaml' || ext === '.yml' || ext === '.ini' || ext === '.env') return PHYSICAL_ICONS.config;
      if (ext === '.json') return PHYSICAL_ICONS.json;
      if (ext === '.html') return PHYSICAL_ICONS.html;
      if (ext === '.css') return PHYSICAL_ICONS.css;
      return PHYSICAL_ICONS.doc;
    }

    function getStackPhysicalIcon(stack) {
      const name = (stack && stack.stack_name ? stack.stack_name : '').toLowerCase();
      const fw = (stack && stack.framework ? stack.framework : '').toLowerCase();
      if (name.includes('python') || fw.includes('django') || fw.includes('fastapi') || fw.includes('flask')) return PHYSICAL_ICONS.py;
      if (name.includes('rust') || fw.includes('actix') || fw.includes('tokio')) return PHYSICAL_ICONS.rs;
      if (name.includes('node') || name.includes('javascript') || fw.includes('express')) return PHYSICAL_ICONS.js;
      if (name.includes('typescript') || fw.includes('react') || fw.includes('vue') || fw.includes('next')) return PHYSICAL_ICONS.ts;
      if (name.includes('docker')) return PHYSICAL_ICONS.config;
      return PHYSICAL_ICONS.py;
    }

    // Command Registry with 100% Tangible Skeuomorphic Icons
    const COMMAND_REGISTRY = [
      { id: 'new_file', title: 'New File', desc: 'Create a new script in user workspace', shortcut: 'Alt+N', icon: PHYSICAL_ICONS.newFile, action: () => showInlineCreate('file') },
      { id: 'new_folder', title: 'New Folder', desc: 'Create a new folder in user workspace', shortcut: '', icon: PHYSICAL_ICONS.folder, action: () => showInlineCreate('folder') },
      { id: 'upload_file', title: 'Upload Files', desc: 'Upload scripts or assets into user workspace', shortcut: '', icon: PHYSICAL_ICONS.upload, action: () => triggerWorkspaceUpload() },
      { id: 'run_code', title: 'Run Active Editor File', desc: 'Execute current Python or Node script natively', shortcut: 'Ctrl+Enter', icon: PHYSICAL_ICONS.jewelPlay, action: () => runActiveEditorFile() },
      { id: 'save_file', title: 'Save Active Editor File', desc: 'Persist changes directly to workspace disk', shortcut: 'Ctrl+S', icon: PHYSICAL_ICONS.floppy, action: () => saveActiveEditorFile() },
      { id: 'quick_open', title: 'Quick Open File', desc: 'Fuzzy-search and jump between workspace files', shortcut: 'Ctrl+P', icon: PHYSICAL_ICONS.folder, action: () => openQuickOpen() },
      { id: 'unit_tests', title: 'Run Automated Unit Tests', desc: 'Execute regression suite for system invariants', shortcut: '', icon: PHYSICAL_ICONS.testTubes, action: () => triggerRunUnitTests() },
      { id: 'data_plot', title: 'Analyze CSV & Plot Matplotlib Chart', desc: 'Parse telemetry dataset and plot dark-mode charts', shortcut: '', icon: PHYSICAL_ICONS.oscilloscope, action: () => triggerStudioPrompt('data') },
      { id: 'rag_search', title: 'Search Local Workspace (BM25 RAG)', desc: 'Retrieve code & citations from repository', shortcut: '', icon: PHYSICAL_ICONS.magnifier, action: () => triggerStudioPrompt('rag') },
      { id: 'video_synth', title: 'Synthesize 30FPS MP4 Procedural Video', desc: 'Render neural generative video with OpenCV', shortcut: '', icon: PHYSICAL_ICONS.reel, action: () => triggerStudioPrompt('video') },
      { id: 'beat_song', title: 'Synthesize Gengetone / Trap Beat & Song', desc: 'Compose 16-bar algorithmic beat and lyrics', shortcut: '', icon: PHYSICAL_ICONS.tape, action: () => triggerStudioPrompt('beat') },
      { id: 'doc_suite', title: 'Compile Academic Whitepaper to PDF & DOCX', desc: 'Generate ReportLab PDF and OpenXML Word DOCX', shortcut: '', icon: PHYSICAL_ICONS.doc, action: () => triggerStudioPrompt('document') },
      { id: 'deep_research', title: 'Launch Autonomous Deep Research', desc: 'Deconstruct hypotheses and build comparative matrix', shortcut: '', icon: PHYSICAL_ICONS.microscope, action: () => triggerStudioPrompt('research') },
      { id: 'toggle_terminal', title: 'Toggle Integrated Terminal', desc: 'Expand or collapse the bottom CLI drawer', shortcut: 'Ctrl+`', icon: PHYSICAL_ICONS.terminalScreen, action: () => toggleBottomTerminal() },
      { id: 'mode_split', title: 'Switch to Split Dual Workbench', desc: 'Show both Monaco Editor and Anjiru Copilot', shortcut: '', icon: PHYSICAL_ICONS.dualMonitors, action: () => setLayoutMode('split') },
      { id: 'mode_editor', title: 'Switch to Editor-Only View', desc: 'Maximize screen space for coding and syntax highlighting', shortcut: '', icon: PHYSICAL_ICONS.codeScreen, action: () => setLayoutMode('editor') },
      { id: 'mode_chat', title: 'Switch to Copilot Chat View', desc: 'Focus entirely on interactive AI conversation', shortcut: '', icon: PHYSICAL_ICONS.mic, action: () => setLayoutMode('chat') },
      { id: 'cycle_theme', title: 'Cycle Cyber Visual Theme', desc: 'Toggle Emerald, Cyberpunk, Solar, or Midnight glow', shortcut: '', icon: PHYSICAL_ICONS.lens, action: () => cycleTheme() },
      { id: 'clear_terminal', title: 'Clear Terminal Output', desc: 'Reset the execution shell screen', shortcut: '', icon: PHYSICAL_ICONS.eraser, action: () => clearTerminalOutput() }
    ];

    // Pro Code Templates
    const CODE_TEMPLATES = {
      mcculloch: `def mcculloch_pitts_neuron(inputs, weights, threshold, inhibitory=False):
    """
    Warren McCulloch & Walter Pitts (1943) Threshold Logic Unit (TLU).
    Invariant: Absolute inhibitory veto overrides any excitatory sum.
    """
    if inhibitory:
        return 0
    net_excitation = sum(x * w for x, w in zip(inputs, weights))
    return 1 if net_excitation >= threshold else 0

if __name__ == '__main__':
    print("[*] Simulating McCulloch-Pitts Propositional Logic:")
    print(f"AND(1, 1) -> {mcculloch_pitts_neuron([1, 1], [1, 1], 2)}")
    print(f"AND(1, 0) -> {mcculloch_pitts_neuron([1, 0], [1, 1], 2)}")
`,
      attention: `import math

def scaled_dot_product_attention(Q, K, V):
    """Attention(Q, K, V) = softmax(Q K^T / sqrt(d_k)) V"""
    d_k = len(Q[0])
    scale = math.sqrt(d_k)
    scores = [[sum(q[i] * k[i] for i in range(d_k)) / scale for k in K] for q in Q]
    weights = []
    for row in scores:
        exp_row = [math.exp(x - max(row)) for x in row]
        s = sum(exp_row)
        weights.append([x / s for x in exp_row])
    d_v = len(V[0])
    context = [[sum(weights[i][j] * V[j][m] for j in range(len(K))) for m in range(d_v)] for i in range(len(Q))]
    return weights, context

if __name__ == '__main__':
    Q = [[1.0, 0.0], [0.0, 1.0]]
    K = [[1.0, 0.0], [0.0, 1.0]]
    V = [[10.0, 1.0], [2.0, 20.0]]
    w, ctx = scaled_dot_product_attention(Q, K, V)
    print(f"[✓] Attention weights: {w}")
    print(f"[✓] Projected context: {ctx}")
`,
      plot: `import matplotlib
matplotlib.use('Agg')
import matplotlib.pyplot as plt

def generate_telemetry_plot():
    epochs = list(range(1, 11))
    loss = [0.85, 0.62, 0.44, 0.31, 0.22, 0.16, 0.12, 0.09, 0.07, 0.05]
    
    plt.style.use('dark_background')
    fig, ax = plt.subplots(figsize=(8, 4), dpi=150)
    ax.plot(epochs, loss, color='#10b981', marker='o', linewidth=2.5, label='Cross-Entropy Loss')
    ax.set_title("Anjiru Convergence Metrics", color='#f0f6fc', fontsize=12, pad=12)
    ax.set_xlabel("Epoch", color='#8b949e')
    ax.set_ylabel("Loss", color='#8b949e')
    ax.grid(True, linestyle='--', alpha=0.25, color='#30363d')
    ax.legend()
    fig.tight_layout()
    plt.savefig("loss_curve.png", dpi=150)
    plt.close()
    print("[✓] Plot saved to loss_curve.png")

if __name__ == '__main__':
    generate_telemetry_plot()
`,
      entropy: `import math
import collections

def shannon_entropy(data: str):
    """H(X) = -sum(P(x) * log2(P(x)))"""
    if not data:
        return 0.0
    length = len(data)
    counts = collections.Counter(data)
    h = -sum((cnt / length) * math.log2(cnt / length) for cnt in counts.values())
    print(f"[*] Alphabet: {len(counts)} symbols | Total: {length} chars")
    print(f"[✓] Shannon Entropy: {h:.4f} bits/symbol")
    return h

if __name__ == '__main__':
    shannon_entropy("ANJIRU_AI_SOVEREIGN_FOUNDATION_MODEL")
`,
      threading: `import queue
import threading

def run_worker_pool():
    q = queue.Queue()
    results = []
    lock = threading.Lock()
    
    def worker(wid):
        while not q.empty():
            try:
                task = q.get_nowait()
                res = task ** 2
                with lock:
                    results.append((task, res))
                print(f"[Worker-{wid}] Processed {task} -> {res}")
                q.task_done()
            except queue.Empty:
                break
                
    for i in range(1, 13):
        q.put(i)
    threads = [threading.Thread(target=worker, args=(i,)) for i in range(3)]
    for t in threads: t.start()
    for t in threads: t.join()
    print(f"[✓] Completed {len(results)} concurrent tasks.")

if __name__ == '__main__':
    run_worker_pool()
`
    };

    // 1. Initialize Monaco Editor
    if (typeof require !== "undefined") {
      require.config({ paths: { vs: 'https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.45.0/min/vs' } });
      require(['vs/editor/editor.main'], function () {
        isMonacoLoaded = true;
        monacoEditor = monaco.editor.create(document.getElementById('monaco-editor-container'), {
          value: '# Welcome to Anjiru.AI Sovereign Workbench\n# Click "+ " in the left explorer to create a new file, or ask Copilot on the right!\nprint("Anjiru Engine Ready.")\n',
          language: 'python',
          theme: 'vs-dark',
          fontSize: 13,
          fontFamily: "'JetBrains Mono', Consolas, monospace",
          lineNumbers: 'on',
          roundedSelection: false,
          scrollBeyondLastLine: false,
          readOnly: false,
          automaticLayout: true,
          minimap: { enabled: true }
        });

        monacoEditor.onDidChangeCursorPosition(e => {
          document.getElementById('editor-cursor-pos').innerText = `Ln ${e.position.lineNumber}, Col ${e.position.column}`;
        });

        monacoEditor.addCommand(monaco.KeyMod.CtrlCmd | monaco.KeyCode.KeyS, () => {
          saveActiveEditorFile();
        });

        monacoEditor.addCommand(monaco.KeyMod.CtrlCmd | monaco.KeyCode.Enter, () => {
          runActiveEditorFile();
        });

        loadProjectFiles();
      });
    } else {
      document.getElementById('monaco-editor-container').style.display = 'none';
      document.getElementById('fallback-editor').style.display = 'block';
      loadProjectFiles();
    }

    // 2. Global Hotkey Listeners
    window.addEventListener('keydown', (e) => {
      const isMac = navigator.platform.toUpperCase().indexOf('MAC') >= 0;
      const cmdKey = isMac ? e.metaKey : e.ctrlKey;

      if (cmdKey && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        openCommandPalette();
      } else if (cmdKey && e.key.toLowerCase() === 'p') {
        e.preventDefault();
        openQuickOpen();
      } else if (cmdKey && e.key.toLowerCase() === 's') {
        e.preventDefault();
        saveActiveEditorFile();
      } else if (cmdKey && e.key === '`') {
        e.preventDefault();
        toggleBottomTerminal();
      } else if (e.altKey && e.key.toLowerCase() === 'n') {
        e.preventDefault();
        showInlineCreate('file');
      } else if (e.key === 'Escape') {
        closeAllModals();
      }
    });

    function closeAllModals() {
      document.getElementById('cmd-palette-modal').classList.remove('open');
      document.getElementById('quick-open-modal').classList.remove('open');
      document.getElementById('confirm-dialog-modal').classList.remove('open');
      document.getElementById('template-dropdown-menu').classList.remove('open');
      removeInlineCreateRow();
    }

    // 3. Custom Asynchronous Confirm Modal (NO primitive browser popups!)
    function customConfirm(title, message) {
      return new Promise((resolve) => {
        confirmResolver = resolve;
        document.getElementById('confirm-modal-title').innerText = title;
        document.getElementById('confirm-modal-msg').innerText = message;
        document.getElementById('confirm-dialog-modal').classList.add('open');
      });
    }

    function closeConfirmModal(result) {
      document.getElementById('confirm-dialog-modal').classList.remove('open');
      if (confirmResolver) {
        confirmResolver(result);
        confirmResolver = null;
      }
    }

    // 4. Clean Isolated User Workspace File Management
    async function loadProjectFiles() {
      const container = document.getElementById("project-file-list");
      try {
        const res = await fetch("/api/workspace/files");
        if (res.ok) {
          const data = await res.json();
          const items = data.files || [];
          allWorkspaceFiles = items;
          const statFilesEl = document.getElementById('stat-files');
          if (statFilesEl) {
            statFilesEl.innerHTML = `
              <svg class="phys-icon" width="12" height="12" viewBox="0 0 24 24" fill="none">
                <rect x="3" y="6" width="18" height="14" rx="1.5" fill="url(#p-fld-back)"/>
                <rect x="4" y="4" width="16" height="14" rx="1.5" fill="url(#p-fld-front)"/>
                <line x1="7" y1="8" x2="17" y2="8" stroke="rgba(255,255,255,0.4)" stroke-width="0.8"/>
              </svg>
              <span>${items.length} Files</span>
            `;
          }

          container.innerHTML = "";

          // Clean empty state when user workspace has no files
          if (items.length === 0) {
            container.innerHTML = `
              <div class="empty-workspace-view">
                <div class="empty-workspace-icon" style="margin-bottom:12px;">${PHYSICAL_ICONS.folder}</div>
                <div class="empty-workspace-title">Workspace is Empty</div>
                <div class="empty-workspace-desc">Create your first script or upload your files to get started.</div>
                <div class="empty-workspace-actions">
                  <button class="btn-workspace-action" onclick="showInlineCreate('file')">${PHYSICAL_ICONS.doc} New File</button>
                  <button class="btn-workspace-action" onclick="showInlineCreate('folder')">${PHYSICAL_ICONS.folder} New Folder</button>
                  <button class="btn-workspace-action" onclick="triggerWorkspaceUpload()">
                    <svg class="phys-icon" width="13" height="13" viewBox="0 0 24 24" fill="none">
                      <path d="M12 3V13M12 3L8 7M12 3L16 7" stroke="url(#p-brass)" stroke-width="1.8" stroke-linecap="round"/>
                    </svg>
                    Upload Files
                  </button>
                </div>
              </div>
            `;
            return;
          }

          items.forEach(item => {
            const div = document.createElement("div");
            div.className = "file-item" + (item.path === activeTabPath ? " active" : "");
            const iconSvg = getPhysicalFileIcon(item);
            div.innerHTML = `
              <div class="file-label" onclick="${item.is_dir ? `toggleFolder('${escapeHtml(item.path)}')` : `openFileInTab('${escapeHtml(item.path)}')`}">
                <span>${iconSvg}</span>
                <span>${escapeHtml(item.name)}</span>
              </div>
              <div class="file-actions-hover">
                <button class="btn-item-icon" onclick="startInlineRename(event, '${escapeHtml(item.path)}', '${escapeHtml(item.name)}')" title="Rename">${PHYSICAL_ICONS.pencil}</button>
                <button class="btn-item-icon del" onclick="deleteWorkspacePath(event, '${escapeHtml(item.path)}', ${item.is_dir})" title="Delete">${PHYSICAL_ICONS.trash}</button>
              </div>
            `;
            container.appendChild(div);
          });
          refreshPolyglotStack();
        }
      } catch (err) {
        container.innerHTML = `<div style="color: #ef4444; font-size: 11px; padding: 8px;">Failed to load files: ${err.message}</div>`;
      }
    }

    // 5. INLINE FILE & FOLDER CREATION (ZERO BROWSER POPUPS!)
    function showInlineCreate(type = 'file') {
      removeInlineCreateRow();
      const container = document.getElementById("project-file-list");

      // Clear empty view if present
      const emptyView = container.querySelector('.empty-workspace-view');
      if (emptyView) emptyView.style.display = 'none';

      const icon = type === 'folder' ? PHYSICAL_ICONS.folder : PHYSICAL_ICONS.doc;
      const placeholder = type === 'folder' ? 'folder_name' : 'script.py';

      const box = document.createElement('div');
      box.className = 'inline-create-box';
      box.id = 'inline-create-container';
      box.innerHTML = `
        <span class="btn-phys-icon">${icon}</span>
        <input type="text" class="inline-create-input" id="inline-create-field" placeholder="${placeholder}" autofocus>
      `;

      container.insertBefore(box, container.firstChild);
      const input = document.getElementById('inline-create-field');
      input.focus();

      input.addEventListener('keydown', async (e) => {
        if (e.key === 'Enter') {
          const val = input.value.trim();
          if (!val) {
            removeInlineCreateRow();
            return;
          }
          if (type === 'folder') {
            await createFolderDirect(val);
          } else {
            await createFileDirect(val);
          }
          removeInlineCreateRow();
        } else if (e.key === 'Escape') {
          removeInlineCreateRow();
        }
      });
    }

    function removeInlineCreateRow() {
      const el = document.getElementById('inline-create-container');
      if (el) el.remove();
      const emptyView = document.querySelector('.empty-workspace-view');
      if (emptyView && allWorkspaceFiles.length === 0) emptyView.style.display = 'flex';
    }

    async function createFileDirect(name) {
      try {
        const clean = name.endsWith('.py') || name.includes('.') ? name : `${name}.py`;
        const res = await fetch("/api/workspace/write", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ path: clean, content: "# " + clean + "\nprint('Script initialized.')\n" })
        });
        if (res.ok) {
          showToast(`Created file: ${clean}`, 'success');
          await loadProjectFiles();
          openFileInTab(clean);
        }
      } catch (e) {
        showToast(`Failed to create: ${e.message}`, 'error');
      }
    }

    async function createFolderDirect(name) {
      try {
        const res = await fetch("/api/workspace/create_folder", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ path: name })
        });
        if (res.ok) {
          showToast(`Created folder: ${name}`, 'success');
          await loadProjectFiles();
        }
      } catch (e) {
        showToast(`Failed to create folder: ${e.message}`, 'error');
      }
    }

    // 6. INLINE RENAME & DELETE
    async function startInlineRename(e, path, oldName) {
      e.stopPropagation();
      const newName = prompt(`Rename ${oldName} to:`, oldName);
      if (!newName || newName === oldName) return;

      const parts = path.split('/');
      parts.pop();
      const newPath = parts.length > 0 ? `${parts.join('/')}/${newName}` : newName;

      try {
        const res = await fetch("/api/workspace/rename", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ old_path: path, new_path: newPath })
        });
        if (res.ok) {
          showToast(`Renamed to ${newName}`, 'success');
          // If active tab was renamed, update it
          if (activeTabPath === path) {
            openTabs = openTabs.map(t => t === path ? newPath : t);
            activeTabPath = newPath;
          }
          await loadProjectFiles();
          renderEditorTabs();
        }
      } catch (err) {
        showToast(`Rename error: ${err.message}`, 'error');
      }
    }

    async function deleteWorkspacePath(e, path, isDir) {
      e.stopPropagation();
      const confirmed = await customConfirm(`Delete ${isDir ? 'Folder' : 'File'}?`, `Are you sure you want to permanently delete '${path}' from the workspace?`);
      if (!confirmed) return;

      try {
        const res = await fetch("/api/workspace/delete", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ path })
        });
        if (res.ok) {
          closeEditorTab(null, path);
          await loadProjectFiles();
          showToast(`Deleted ${path}`, 'info');
        }
      } catch (err) {
        showToast(`Delete failed: ${err.message}`, 'error');
      }
    }

    async function confirmClearWorkspace() {
      const confirmed = await customConfirm("Clear Workspace?", "This will remove all user project files and folders from the workspace. Proceed?");
      if (!confirmed) return;

      for (const f of allWorkspaceFiles) {
        try {
          await fetch("/api/workspace/delete", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ path: f.path })
          });
        } catch (_) {}
      }
      openTabs = [];
      activeTabPath = "";
      if (isMonacoLoaded && monacoEditor) monacoEditor.setValue("");
      renderEditorTabs();
      await loadProjectFiles();
      showToast("Workspace cleared.", "info");
    }

    // 7. FILE UPLOAD & DRAG-AND-DROP TO WORKSPACE
    function triggerWorkspaceUpload() {
      document.getElementById('workspace-file-uploader').click();
    }

    async function handleWorkspaceUploadSelected(event) {
      const files = event.target.files;
      if (!files || files.length === 0) return;
      for (let i = 0; i < files.length; i++) {
        await uploadSingleFile(files[i]);
      }
      event.target.value = '';
      await loadProjectFiles();
    }

    function handleDragOver(e) {
      e.preventDefault();
      document.getElementById('sidebar-panel').classList.add('drag-over');
    }

    function handleDragLeave(e) {
      document.getElementById('sidebar-panel').classList.remove('drag-over');
    }

    async function handleDropFile(e) {
      e.preventDefault();
      document.getElementById('sidebar-panel').classList.remove('drag-over');
      if (e.dataTransfer.files && e.dataTransfer.files.length > 0) {
        for (let i = 0; i < e.dataTransfer.files.length; i++) {
          await uploadSingleFile(e.dataTransfer.files[i]);
        }
        await loadProjectFiles();
      }
    }

    async function uploadSingleFile(file) {
      return new Promise((resolve) => {
        const reader = new FileReader();
        reader.onload = async () => {
          const b64 = reader.result.split(',')[1];
          try {
            await fetch('/api/workspace/upload', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ file_name: file.name, content_base64: b64 })
            });
            showToast(`Uploaded ${file.name}`, 'success');
            openFileInTab(file.name);
          } catch (err) {
            showToast(`Upload failed: ${err.message}`, 'error');
          }
          resolve();
        };
        reader.readAsDataURL(file);
      });
    }

    // 8. OPEN FILE IN TAB (PREVENT MONACO CORRUPTION FOR BINARY FILES!)
    async function openFileInTab(relPath) {
      if (!openTabs.includes(relPath)) {
        openTabs.push(relPath);
      }
      activeTabPath = relPath;
      document.getElementById("active-breadcrumb").innerText = relPath;
      document.getElementById("editor-path-indicator").innerText = relPath;
      renderEditorTabs();

      const ext = '.' + relPath.split('.').pop().toLowerCase();
      const isMedia = ['.wav', '.mp3', '.mp4', '.png', '.jpg', '.jpeg', '.pdf'].includes(ext);

      const monacoContainer = document.getElementById('monaco-editor-container');
      const mediaPreview = document.getElementById('editor-media-preview');

      if (isMedia) {
        // Hide Monaco and display media viewer instead of raw byte corrupt characters!
        monacoContainer.style.display = 'none';
        mediaPreview.style.display = 'flex';
        renderMediaPreview(relPath, ext);
        return;
      }

      // Code / text file -> show Monaco Editor
      mediaPreview.style.display = 'none';
      monacoContainer.style.display = 'block';

      try {
        const res = await fetch("/api/workspace/read", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ path: relPath })
        });
        if (res.ok) {
          const data = await res.json();
          const content = data.content || "";
          if (isMonacoLoaded && monacoEditor) {
            const lang = getMonacoLanguage(relPath);
            monaco.editor.setModelLanguage(monacoEditor.getModel(), lang);
            monacoEditor.setValue(content);
          } else {
            document.getElementById("fallback-editor").value = content;
          }
        }
      } catch (err) {
        appendTerminalOutput(`Error opening ${relPath}: ${err.message}`);
      }
      loadProjectFiles();
    }

    function renderMediaPreview(path, ext) {
      const container = document.getElementById('media-preview-content');
      if (ext === '.wav' || ext === '.mp3') {
        container.innerHTML = `
          <div style="background:#0b111a; border:1px solid var(--accent-emerald); border-radius:12px; padding:24px; text-align:center; min-width:320px;">
            <div style="margin-bottom:12px; display:flex; justify-content:center;">
              <svg class="phys-icon" width="56" height="56" viewBox="0 0 24 24" fill="none">
                <rect x="2" y="4" width="20" height="15" rx="2" fill="#1e293b" stroke="url(#p-silver)" stroke-width="0.8"/>
                <rect x="4" y="6" width="16" height="9" rx="1" fill="#f8fafc" stroke="#cbd5e1" stroke-width="0.5"/>
                <rect x="6.5" y="8" width="11" height="5" rx="1.5" fill="#0f172a"/>
                <circle cx="9" cy="10.5" r="1.8" fill="#ca8a04" stroke="#fef08a" stroke-width="0.5"/>
                <circle cx="15" cy="10.5" r="1.8" fill="#ca8a04" stroke="#fef08a" stroke-width="0.5"/>
                <line x1="9" y1="11.5" x2="15" y2="11.5" stroke="#94a3b8" stroke-width="0.8"/>
              </svg>
            </div>
            <div style="font-weight:700; color:#fff; font-size:14px; margin-bottom:4px;">${escapeHtml(path)}</div>
            <div style="font-size:11px; color:var(--text-dim); margin-bottom:16px;">Binary Magnetic Audio Recording</div>
            <audio controls src="/api/audio/download?file=${encodeURIComponent(path)}" style="width:100%;"></audio>
          </div>
        `;
      } else if (ext === '.mp4') {
        container.innerHTML = `
          <div style="background:#0b111a; border:1px solid var(--accent-cyan); border-radius:12px; padding:20px; text-align:center; max-width:600px;">
            <div style="display:flex; align-items:center; justify-content:center; gap:8px; font-weight:700; color:#fff; font-size:14px; margin-bottom:12px;">
              <svg class="phys-icon" width="20" height="20" viewBox="0 0 24 24" fill="none">
                <circle cx="12" cy="12" r="9.5" fill="#334155" stroke="url(#p-silver)" stroke-width="0.9"/>
                <circle cx="12" cy="12" r="3" fill="#0f172a" stroke="url(#p-brass)" stroke-width="0.8"/>
                <circle cx="12" cy="6.2" r="1.6" fill="#0f172a"/>
                <circle cx="12" cy="17.8" r="1.6" fill="#0f172a"/>
                <circle cx="6.2" cy="12" r="1.6" fill="#0f172a"/>
                <circle cx="17.8" cy="12" r="1.6" fill="#0f172a"/>
              </svg>
              <span>${escapeHtml(path)}</span>
            </div>
            <video controls src="/api/video/download?file=${encodeURIComponent(path)}" style="width:100%; border-radius:8px;"></video>
          </div>
        `;
      } else if (['.png', '.jpg', '.jpeg'].includes(ext)) {
        container.innerHTML = `
          <div style="text-align:center;">
            <img src="/api/plots/view?file=${encodeURIComponent(path)}" style="max-width:90%; max-height:70vh; border-radius:8px; box-shadow:0 10px 30px rgba(0,0,0,0.8);">
            <div style="margin-top:10px; font-size:12px; color:var(--text-dim);">${escapeHtml(path)}</div>
          </div>
        `;
      } else {
        container.innerHTML = `
          <div style="text-align:center; color:var(--text-muted);">
            <div style="margin-bottom:12px; display:flex; justify-content:center;">
              <svg class="phys-icon" width="48" height="48" viewBox="0 0 24 24" fill="none">
                <path d="M4 3.5C4 2.7 4.7 2 5.5 2H15.5L20 6.5V20.5C20 21.3 19.3 22 18.5 22H5.5C4.7 22 4 21.3 4 20.5V3.5Z" fill="#f8fafc" stroke="#cbd5e1" stroke-width="0.6"/>
                <path d="M15 2L20 7H16.5C15.7 7 15 6.3 15 5.5V2Z" fill="#cbd5e1"/>
                <line x1="7" y1="9" x2="14" y2="9" stroke="#94a3b8" stroke-width="0.8" stroke-linecap="round"/>
                <line x1="7" y1="12" x2="16" y2="12" stroke="#94a3b8" stroke-width="0.8" stroke-linecap="round"/>
              </svg>
            </div>
            <div style="color:#fff; font-weight:600;">${escapeHtml(path)}</div>
            <div style="font-size:11.5px; margin-top:4px;">Binary Document format. Open or download to inspect.</div>
          </div>
        `;
      }
    }

    function renderEditorTabs() {
      const container = document.getElementById("editor-tabs-container");
      container.innerHTML = "";
      openTabs.forEach(p => {
        const tab = document.createElement("div");
        tab.className = "editor-tab" + (p === activeTabPath ? " active" : "");
        const baseName = p.split("/").pop();
        const iconSvg = getPhysicalFileIcon({ path: p, is_dir: false });
        tab.innerHTML = `
          <span style="display:inline-flex;align-items:center;gap:6px;" onclick="openFileInTab('${escapeHtml(p)}')">
            <span class="btn-phys-icon">${iconSvg}</span>
            <span>${escapeHtml(baseName)}</span>
          </span>
          <span class="tab-close-btn" onclick="closeEditorTab(event, '${escapeHtml(p)}')" title="Close Tab">
            <svg class="phys-icon" width="8" height="8" viewBox="0 0 20 20" fill="none">
              <path d="M5 5L15 15M15 5L5 15" stroke="#94a3b8" stroke-width="2.5" stroke-linecap="round"/>
            </svg>
          </span>
        `;
        container.appendChild(tab);
      });
    }

    function closeEditorTab(e, p) {
      if (e) e.stopPropagation();
      openTabs = openTabs.filter(x => x !== p);
      if (activeTabPath === p) {
        activeTabPath = openTabs.length > 0 ? openTabs[openTabs.length - 1] : "";
        if (activeTabPath) openFileInTab(activeTabPath);
        else {
          if (isMonacoLoaded && monacoEditor) monacoEditor.setValue("# Welcome to Anjiru AI\n# Workspace is clean. Create or open a file to start coding.\n");
          document.getElementById("active-breadcrumb").innerText = "user_projects";
          document.getElementById("editor-path-indicator").innerText = "(No file open)";
        }
      }
      renderEditorTabs();
    }

    async function saveActiveEditorFile() {
      if (!activeTabPath) {
        showToast("No active file to save. Click + to create one.", "info");
        return;
      }
      const code = isMonacoLoaded && monacoEditor ? monacoEditor.getValue() : document.getElementById("fallback-editor").value;
      try {
        const res = await fetch("/api/workspace/write", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ path: activeTabPath, content: code })
        });
        if (res.ok) {
          appendTerminalOutput(`[✓] Successfully saved ${activeTabPath}`);
          showToast(`Saved ${activeTabPath}`, 'success');
        }
      } catch (e) {
        showToast(`Save error: ${e.message}`, 'error');
      }
    }

    function getMonacoLanguage(relPath) {
      if (!relPath) return "plaintext";
      const ext = '.' + relPath.split('.').pop().toLowerCase();
      const map = {
        '.py': 'python',
        '.js': 'javascript',
        '.mjs': 'javascript',
        '.ts': 'typescript',
        '.tsx': 'typescript',
        '.rs': 'rust',
        '.go': 'go',
        '.cpp': 'cpp',
        '.cc': 'cpp',
        '.cxx': 'cpp',
        '.hpp': 'cpp',
        '.c': 'c',
        '.h': 'c',
        '.cs': 'csharp',
        '.java': 'java',
        '.kt': 'kotlin',
        '.kts': 'kotlin',
        '.swift': 'swift',
        '.dart': 'dart',
        '.php': 'php',
        '.rb': 'ruby',
        '.html': 'html',
        '.htm': 'html',
        '.css': 'css',
        '.json': 'json',
        '.sql': 'sql',
        '.sh': 'shell',
        '.bash': 'shell',
        '.ps1': 'powershell',
        '.md': 'markdown',
        '.yaml': 'yaml',
        '.yml': 'yaml',
        '.toml': 'toml'
      };
      return map[ext] || 'plaintext';
    }

    function getExecutionLanguage(relPath) {
      if (!relPath) return "python";
      const ext = '.' + relPath.split('.').pop().toLowerCase();
      const map = {
        '.py': 'python',
        '.js': 'javascript',
        '.mjs': 'javascript',
        '.ts': 'typescript',
        '.tsx': 'typescript',
        '.rs': 'rust',
        '.go': 'go',
        '.cpp': 'cpp',
        '.cc': 'cpp',
        '.cxx': 'cpp',
        '.c': 'c',
        '.sh': 'shell',
        '.bash': 'shell',
        '.ps1': 'powershell'
      };
      return map[ext] || 'python';
    }

    // 9. Code Execution
    async function runActiveEditorFile() {
      const code = isMonacoLoaded && monacoEditor ? monacoEditor.getValue() : document.getElementById("fallback-editor").value;
      const lang = getExecutionLanguage(activeTabPath);
      executeCodeSnippet(code, lang, activeTabPath || "Active Script");
    }

    async function executeCodeSnippet(code, lang = "python", label = "Snippet") {
      openBottomTerminal();
      appendTerminalOutput(`\n[*] Executing [${label}] via native subprocess (${lang})...`);
      isAiThinking = true;

      try {
        const res = await fetch("/api/exec/run", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ code, language: lang })
        });
        const d = await res.json();
        isAiThinking = false;
        if (d.status === "success" && d.exit_code === 0) {
          appendTerminalOutput(d.stdout || "(Process completed with exit code 0 and no output)");
          appendTerminalOutput(`[✓] Exit Code: 0 in ${d.duration_ms}ms`);
          showToast(`Execution finished (${d.duration_ms}ms)`, 'success');
        } else {
          appendTerminalOutput(d.stdout || "");
          appendTerminalOutput(`[✕] Error (Exit Code ${d.exit_code}):\n${d.stderr}`);
          showToast(`Process failed (Exit ${d.exit_code})`, 'error');
        }
      } catch (err) {
        isAiThinking = false;
        appendTerminalOutput(`[✕] Execution failed: ${err.message}`);
        showToast(`Execution error: ${err.message}`, 'error');
      }
    }

    // 10. Command Palette
    function openCommandPalette() {
      closeAllModals();
      const modal = document.getElementById('cmd-palette-modal');
      modal.classList.add('open');
      const input = document.getElementById('cmd-palette-input');
      input.value = '';
      input.focus();
      paletteSelectedIdx = 0;
      renderPaletteItems(COMMAND_REGISTRY);
    }

    function closePaletteIfOverlay(e) {
      if (e.target.id === 'cmd-palette-modal') closeAllModals();
    }

    function renderPaletteItems(items) {
      const list = document.getElementById('cmd-palette-list');
      list.innerHTML = '';
      if (items.length === 0) {
        list.innerHTML = `<div style="padding:16px; color:var(--text-muted); font-size:12px; text-align:center;">No matching commands found.</div>`;
        return;
      }
      items.forEach((item, idx) => {
        const div = document.createElement('div');
        div.className = 'palette-item' + (idx === paletteSelectedIdx ? ' selected' : '');
        div.innerHTML = `
          <div class="palette-item-left">
            <span class="btn-phys-icon" style="display:flex;align-items:center;justify-content:center;width:20px;height:20px;">${item.icon}</span>
            <div>
              <div style="font-weight: 600; color: #fff;">${escapeHtml(item.title)}</div>
              <div style="font-size: 11px; color: var(--text-dim);">${escapeHtml(item.desc)}</div>
            </div>
          </div>
          ${item.shortcut ? `<span class="palette-badge">${escapeHtml(item.shortcut)}</span>` : ''}
        `;
        div.onclick = () => {
          closeAllModals();
          item.action();
        };
        list.appendChild(div);
      });
    }

    function filterPalette(e) {
      const q = e.target.value.toLowerCase().trim();
      const filtered = COMMAND_REGISTRY.filter(c => c.title.toLowerCase().includes(q) || c.desc.toLowerCase().includes(q));
      paletteSelectedIdx = 0;
      renderPaletteItems(filtered);
    }

    function navigatePalette(e) {
      const items = document.querySelectorAll('#cmd-palette-list .palette-item');
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        paletteSelectedIdx = (paletteSelectedIdx + 1) % items.length;
        updatePaletteSelection(items);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        paletteSelectedIdx = (paletteSelectedIdx - 1 + items.length) % items.length;
        updatePaletteSelection(items);
      } else if (e.key === 'Enter') {
        e.preventDefault();
        if (items[paletteSelectedIdx]) items[paletteSelectedIdx].click();
      }
    }

    function updatePaletteSelection(items) {
      items.forEach((el, idx) => {
        if (idx === paletteSelectedIdx) {
          el.classList.add('selected');
          el.scrollIntoView({ block: 'nearest' });
        } else {
          el.classList.remove('selected');
        }
      });
    }

    // 11. Quick Open File (Ctrl + P)
    function openQuickOpen() {
      closeAllModals();
      const modal = document.getElementById('quick-open-modal');
      modal.classList.add('open');
      const input = document.getElementById('quick-open-input');
      input.value = '';
      input.focus();
      quickOpenSelectedIdx = 0;
      renderQuickOpenItems(allWorkspaceFiles);
    }

    function closeQuickOpenIfOverlay(e) {
      if (e.target.id === 'quick-open-modal') closeAllModals();
    }

    function renderQuickOpenItems(files) {
      const list = document.getElementById('quick-open-list');
      list.innerHTML = '';
      if (files.length === 0) {
        list.innerHTML = `<div style="padding:16px; color:var(--text-muted); font-size:12px; text-align:center;">Workspace is empty. Click + to create a file.</div>`;
        return;
      }
      files.forEach((f, idx) => {
        const div = document.createElement('div');
        div.className = 'palette-item' + (idx === quickOpenSelectedIdx ? ' selected' : '');
        const iconSvg = getPhysicalFileIcon(f);
        const sizeKb = (f.size / 1024).toFixed(1);
        div.innerHTML = `
          <div class="palette-item-left">
            <span class="btn-phys-icon" style="display:flex;align-items:center;justify-content:center;width:20px;height:20px;">${iconSvg}</span>
            <div>
              <div style="font-weight: 600; color: #fff;">${escapeHtml(f.name)}</div>
              <div style="font-size: 11px; color: var(--text-dim);">${escapeHtml(f.path)}</div>
            </div>
          </div>
          ${!f.is_dir ? `<span class="palette-badge">${sizeKb} KB</span>` : ''}
        `;
        div.onclick = () => {
          closeAllModals();
          if (!f.is_dir) openFileInTab(f.path);
        };
        list.appendChild(div);
      });
    }

    function filterQuickOpen(e) {
      const q = e.target.value.toLowerCase().trim();
      const filtered = allWorkspaceFiles.filter(f => f.name.toLowerCase().includes(q) || f.path.toLowerCase().includes(q));
      quickOpenSelectedIdx = 0;
      renderQuickOpenItems(filtered);
    }

    function navigateQuickOpen(e) {
      const items = document.querySelectorAll('#quick-open-list .palette-item');
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        quickOpenSelectedIdx = (quickOpenSelectedIdx + 1) % items.length;
        updateQuickOpenSelection(items);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        quickOpenSelectedIdx = (quickOpenSelectedIdx - 1 + items.length) % items.length;
        updateQuickOpenSelection(items);
      } else if (e.key === 'Enter') {
        e.preventDefault();
        if (items[quickOpenSelectedIdx]) items[quickOpenSelectedIdx].click();
      }
    }

    function updateQuickOpenSelection(items) {
      items.forEach((el, idx) => {
        if (idx === quickOpenSelectedIdx) {
          el.classList.add('selected');
          el.scrollIntoView({ block: 'nearest' });
        } else {
          el.classList.remove('selected');
        }
      });
    }

    // 12. Theme Switcher
    function cycleTheme() {
      currentThemeIdx = (currentThemeIdx + 1) % THEMES.length;
      document.body.className = THEMES[currentThemeIdx];
      const name = THEME_NAMES[currentThemeIdx];
      document.getElementById('theme-btn-label').innerText = name;
      showToast(`Switched visual theme to ${name}`, 'info');
      localStorage.setItem('anjiru_theme', currentThemeIdx);
    }
    const savedTheme = localStorage.getItem('anjiru_theme');
    if (savedTheme !== null) {
      currentThemeIdx = parseInt(savedTheme, 10);
      document.body.className = THEMES[currentThemeIdx];
      document.getElementById('theme-btn-label').innerText = THEME_NAMES[currentThemeIdx];
    }

    // 13. Header Waveform
    function initHeaderWave() {
      const canvas = document.getElementById('header-wave-canvas');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      let step = 0;

      function render() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        const style = getComputedStyle(document.body);
        const color = style.getPropertyValue('--accent-emerald').trim() || '#10b981';

        ctx.strokeStyle = color;
        ctx.lineWidth = 1.6;
        ctx.beginPath();

        const speed = isAiThinking ? 0.28 : 0.08;
        step += speed;

        for (let x = 0; x < canvas.width; x++) {
          const freq = isAiThinking ? 0.18 : 0.08;
          const amp = isAiThinking ? 6 : 3;
          const y = canvas.height / 2 + Math.sin(x * freq + step) * amp * Math.sin(x / canvas.width * Math.PI);
          if (x === 0) ctx.moveTo(x, y);
          else ctx.lineTo(x, y);
        }
        ctx.stroke();
        requestAnimationFrame(render);
      }
      requestAnimationFrame(render);
    }
    initHeaderWave();

    // 14. Toast Alerts
    function showToast(message, type = 'info') {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');
      toast.className = 'toast-msg';
      const icon = type === 'success' ? '✓' : (type === 'error' ? '✕' : '⚡');
      toast.innerHTML = `<span style="color:var(--accent-emerald); font-weight:700;">[${icon}]</span> <span>${escapeHtml(message)}</span>`;
      container.appendChild(toast);
      setTimeout(() => {
        toast.style.opacity = '0';
        toast.style.transform = 'translateX(100%)';
        toast.style.transition = 'all 0.25s ease';
        setTimeout(() => toast.remove(), 260);
      }, 3000);
    }

    // 15. Templates
    function toggleTemplateMenu() {
      document.getElementById('template-dropdown-menu').classList.toggle('open');
    }

    function insertCodeTemplate(key) {
      const tpl = CODE_TEMPLATES[key];
      if (!tpl) return;
      document.getElementById('template-dropdown-menu').classList.remove('open');
      if (isMonacoLoaded && monacoEditor) {
        monacoEditor.setValue(tpl);
      } else {
        document.getElementById('fallback-editor').value = tpl;
      }
      showToast("Template loaded into editor.", "success");
    }

    // 16. Copilot Chat Operations
    function sendPrompt(text) {
      document.getElementById("prompt-input").value = text;
      submitChatPrompt();
    }

    async function submitChatPrompt() {
      const textarea = document.getElementById("prompt-input");
      const text = textarea.value.trim();
      if (!text) return;

      const lang = "sheng"; // Unified Indigenous Model
      textarea.value = "";
      textarea.style.height = "38px";

      const welcome = document.getElementById("empty-welcome");
      if (welcome) welcome.remove();

      const viewport = document.getElementById("chat-viewport");

      const userRow = document.createElement("div");
      userRow.className = "msg-user";
      userRow.innerHTML = `<div class="bubble-user">${escapeHtml(text)}</div>`;
      viewport.appendChild(userRow);

      const assistantRow = document.createElement("div");
      assistantRow.className = "msg-assistant";
      assistantRow.innerHTML = `
        <div class="author-line">
          <span>Anjiru.AI</span>
          <span class="author-meta">• Synthesizing</span>
        </div>
        <div class="assistant-body" style="display: flex; align-items: center; gap: 8px; color: var(--accent-emerald);">
          <span class="btn-phys-icon">${PHYSICAL_ICONS.tube}</span>
          <span class="thinking-live-text">Deconstructing inquiry and theoretical invariants...</span>
        </div>
      `;
      viewport.appendChild(assistantRow);
      viewport.scrollTop = viewport.scrollHeight;

      isAiThinking = true;
      const stages = [
        "Deconstructing inquiry and theoretical invariants...",
        "Evaluating mathematical formulations and boundary conditions...",
        "Synthesizing verified algorithmic implementation...",
        "Compiling native register with 72.4% token economy..."
      ];
      let sIdx = 0;
      const thinkTimer = setInterval(() => {
        sIdx = (sIdx + 1) % stages.length;
        const liveText = assistantRow.querySelector(".thinking-live-text");
        if (liveText) liveText.innerText = stages[sIdx];
      }, 850);

      try {
        const res = await fetch("/api/anjiru/chat", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ prompt: text, language: lang })
        });

        clearInterval(thinkTimer);
        isAiThinking = false;
        if (res.ok) {
          const data = await res.json();
          renderAssistantResponse(assistantRow, data);
        } else {
          assistantRow.querySelector(".assistant-body").innerHTML = `<span style="color: #ef4444;">Server error (${res.status})</span>`;
        }
      } catch (err) {
        clearInterval(thinkTimer);
        isAiThinking = false;
        assistantRow.querySelector(".assistant-body").innerHTML = `<span style="color: #ef4444;">Connection failed: ${err.message}</span>`;
      }

      viewport.scrollTop = viewport.scrollHeight;
    }

    function renderAssistantResponse(rowEl, data) {
      const content = data.content || "No content generated.";

      let thoughtHtml = "";
      if (data.thinking && data.thinking.steps) {
        const stepsHtml = data.thinking.steps.map(s => `
          <div class="thought-step-item">
            <span class="thought-step-title">${escapeHtml(s.title)}</span>
            <span class="thought-step-detail">${escapeHtml(s.detail)}</span>
          </div>
        `).join("");

        thoughtHtml = `
          <details class="thought-box" open>
            <summary class="thought-summary">
              <div style="display:flex;align-items:center;gap:7px;">
                <span class="btn-phys-icon">${PHYSICAL_ICONS.gears}</span>
                <span>Thought Process</span>
              </div>
              <span style="font-family:var(--font-mono);font-size:11px;background:var(--bg-active);padding:2px 7px;border-radius:10px;border:1px solid var(--accent-emerald);">${data.thinking.duration_sec || 2.4}s</span>
            </summary>
            <div class="thought-steps">
              ${stepsHtml}
            </div>
          </details>
        `;
      }

      const bodyHtml = parseMarkdownToIde(content);

      rowEl.innerHTML = `
        <div class="author-line">
          <span>Anjiru.AI</span>
          <span class="author-meta">• ${escapeHtml(data.language || 'English')} • ${data.latency_ms}ms</span>
        </div>
        ${thoughtHtml}
        <div class="assistant-body">
          ${bodyHtml}
        </div>
      `;
    }

    function parseMarkdownToIde(md) {
      if (!md) return "";

      const codeBlocks = [];
      let text = md.replace(/```([a-zA-Z0-9_-]*)\n([\s\S]*?)```/g, (match, lang, code) => {
        const id = `__CODE_${codeBlocks.length}__`;
        codeBlocks.push({ lang: lang || 'python', code: code.trim() });
        return id;
      });

      text = text.replace(/^### (.*$)/gim, '<h3>$1</h3>');
      text = text.replace(/^## (.*$)/gim, '<h2>$1</h2>');
      text = text.replace(/^# (.*$)/gim, '<h1>$1</h1>');
      text = text.replace(/^---$/gim, '<hr>');
      text = text.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
      text = text.replace(/`([^`]+)`/g, '<code style="background:rgba(255,255,255,0.08);padding:2px 5px;border-radius:4px;font-family:var(--font-mono);color:var(--accent-cyan);">$1</code>');

      text = text.replace(/(?:^[•\-] (.*(?:\n|$)))+/gim, (match) => {
        const items = match.trim().split('\n').map(line => `<li>${line.replace(/^[•\-]\s*/, '')}</li>`).join('');
        return `<ul>${items}</ul>`;
      });
      text = text.replace(/(?:^\d+\. (.*(?:\n|$)))+/gim, (match) => {
        const items = match.trim().split('\n').map(line => `<li>${line.replace(/^\d+\.\s*/, '')}</li>`).join('');
        return `<ol>${items}</ol>`;
      });

      // Audio media cards
      text = text.replace(/<audio controls[^>]*src="([^"]+)"[^>]*><\/audio>/gi, (m, src) => {
        return `
          <div class="media-card-audio">
            <div class="media-card-header">
              <span style="display:inline-flex;align-items:center;gap:6px;"><span class="btn-phys-icon">${PHYSICAL_ICONS.tape}</span> Algorithmic Beat Track</span>
              <a href="${src}" download class="btn-card-action" style="text-decoration:none;"><span class="btn-phys-icon">${PHYSICAL_ICONS.floppy}</span> Download WAV</a>
            </div>
            <audio controls src="${src}" style="width:100%; margin-top:6px;"></audio>
          </div>
        `;
      });

      // Video media cards
      text = text.replace(/<video controls[^>]*src="([^"]+)"[^>]*><\/video>/gi, (m, src) => {
        return `
          <div class="media-card-video">
            <div class="media-card-header">
              <span style="display:inline-flex;align-items:center;gap:6px;"><span class="btn-phys-icon">${PHYSICAL_ICONS.reel}</span> 30FPS Procedural Video Synth</span>
              <a href="${src}" download class="btn-card-action" style="text-decoration:none;"><span class="btn-phys-icon">${PHYSICAL_ICONS.floppy}</span> Download MP4</a>
            </div>
            <video controls src="${src}"></video>
          </div>
        `;
      });

      // Plot images
      text = text.replace(/<img src="([^"]+)"[^>]*>/gi, (m, src) => {
        return `
          <div class="media-card-plot">
            <div class="media-card-header">
              <span style="display:inline-flex;align-items:center;gap:6px;"><span class="btn-phys-icon">${PHYSICAL_ICONS.oscilloscope}</span> Matplotlib Plot</span>
              <a href="${src}" download class="btn-card-action" style="text-decoration:none;"><span class="btn-phys-icon">${PHYSICAL_ICONS.floppy}</span> Save PNG</a>
            </div>
            <img src="${src}" alt="Plot">
          </div>
        `;
      });

      text = text.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" style="color:var(--accent-emerald);text-decoration:underline;font-weight:600;">$1</a>');

      const paragraphs = text.split(/\n\s*\n/).map(p => {
        p = p.trim();
        if (!p) return "";
        if (p.startsWith("<h") || p.startsWith("<ul") || p.startsWith("<ol") || p.startsWith("<hr") || p.startsWith("<div class=\"media-card") || p.startsWith("__CODE_")) return p;
        return `<p>${p.replace(/\n/g, '<br>')}</p>`;
      }).join('\n');

      let finalHtml = paragraphs;
      codeBlocks.forEach((b) => {
        codeBlockIndex++;
        const cId = `card-code-${codeBlockIndex}`;
        const placeholder = `__CODE_${codeBlocks.indexOf(b)}__`;

        const card = `
          <div class="ai-code-card" id="${cId}">
            <div class="ai-code-header">
              <span>${escapeHtml(b.lang.toUpperCase())}</span>
              <div class="ai-code-actions">
                <button class="btn-card-action btn-card-run" onclick="executeSnippetFromAi('${cId}', '${b.lang}')"><span class="btn-phys-icon">${PHYSICAL_ICONS.jewelPlay}</span> Run</button>
                <button class="btn-card-action" onclick="openSnippetInEditor('${cId}', '${escapeHtml(b.lang)}')"><span class="btn-phys-icon">${PHYSICAL_ICONS.newFile}</span> Add to Workspace</button>
                <button class="btn-card-action" onclick="copySnippetCode('${cId}')"><span class="btn-phys-icon">${PHYSICAL_ICONS.clipboard}</span> Copy</button>
              </div>
            </div>
            <pre class="ai-code-content"><code>${escapeHtml(b.code)}</code></pre>
          </div>
        `;
        finalHtml = finalHtml.replace(placeholder, card);
      });

      return finalHtml;
    }

    function executeSnippetFromAi(cId, lang) {
      const code = document.getElementById(cId).querySelector("pre code").innerText;
      executeCodeSnippet(code, lang, "Copilot Snippet");
    }

    async function openSnippetInEditor(cId, lang) {
      const code = document.getElementById(cId).querySelector("pre code").innerText;
      const extMap = {
        python: '.py', py: '.py',
        rust: '.rs', rs: '.rs',
        go: '.go', golang: '.go',
        typescript: '.ts', ts: '.ts',
        javascript: '.js', js: '.js',
        cpp: '.cpp', 'c++': '.cpp', c: '.c',
        csharp: '.cs', cs: '.cs',
        java: '.java', kotlin: '.kt',
        swift: '.swift', dart: '.dart',
        php: '.php', ruby: '.rb',
        shell: '.sh', bash: '.sh', sh: '.sh',
        sql: '.sql', html: '.html', css: '.css', json: '.json'
      };
      const ext = extMap[(lang || '').toLowerCase()] || '.py';
      const filename = `ai_generated_${Date.now().toString().slice(-4)}${ext}`;
      await fetch("/api/workspace/write", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ path: filename, content: code })
      });
      await loadProjectFiles();
      openFileInTab(filename);
      setLayoutMode('split');
      showToast(`Added ${filename} to workspace`, 'success');
    }

    function copySnippetCode(cId) {
      const code = document.getElementById(cId).querySelector("pre code").innerText;
      navigator.clipboard.writeText(code);
      showToast("Code copied to clipboard!", 'success');
    }

    // 17. Studio Quick Actions
    function triggerStudioPrompt(type) {
      const input = document.getElementById("prompt-input");
      if (type === 'data') input.value = "Analyze the telemetry_metrics.csv dataset and plot a Matplotlib line chart";
      else if (type === 'rag') input.value = "Search local workspace for McCulloch-Pitts threshold logic neuron";
      else if (type === 'beat') input.value = "Create a gengetone beat and write a song";
      else if (type === 'video') input.value = "Create a video of cybernetic neural network synapses";
      else if (type === 'document') input.value = "Write an essay on Sovereign AI Systems and compile to PDF and DOCX";
      else if (type === 'research') input.value = "Do deep research on how to solve traffic gridlock using distributed sensors";
      input.focus();
    }

    async function triggerRunUnitTests() {
      openBottomTerminal();
      switchBottomTab("terminal");
      appendTerminalOutput("\n[*] Launching Automated Unit Testing Suite (python run_unit_tests.py)...");
      showToast("Running automated test suite...", "info");
      isAiThinking = true;

      try {
        const res = await fetch("/api/tests/run", { method: "POST" });
        const data = await res.json();
        isAiThinking = false;
        if (data.status === "success") {
          appendTerminalOutput(data.stdout || "[✓] All tests passed successfully.");
          showToast("All 6 Unit Tests Passed!", "success");
        } else {
          appendTerminalOutput((data.stdout || "") + "\n" + (data.stderr || "Test execution error."));
          showToast("Test Failures Detected", "error");
        }
      } catch (err) {
        isAiThinking = false;
        appendTerminalOutput(`[x] Failed to run tests: ${err.message}`);
        showToast(`Test error: ${err.message}`, "error");
      }
    }

    function askAiToDebugEditor() {
      const code = isMonacoLoaded && monacoEditor ? monacoEditor.getValue() : document.getElementById("fallback-editor").value;
      sendPrompt(`Debug and optimize this code from the editor:\n\`\`\`python\n${code}\n\`\`\`\n\nAnalyze theoretical invariants, resolve any potential bugs, and explain optimizations.`);
      setLayoutMode('split');
    }

    // 18. Terminal Shell
    function appendTerminalOutput(text) {
      const screen = document.getElementById("terminal-screen");
      screen.innerText += `\n${text}`;
      screen.scrollTop = screen.scrollHeight;
    }

    function clearTerminalOutput() {
      document.getElementById("terminal-screen").innerText = "[*] Terminal cleared. Ready.";
      showToast("Terminal cleared", "info");
    }

    function openBottomTerminal() {
      document.getElementById("bottom-panel").classList.remove("collapsed");
    }

    function toggleBottomTerminal() {
      document.getElementById("bottom-panel").classList.toggle("collapsed");
    }

    async function handleTerminalEnter(e) {
      if (e.key === "Enter") {
        const input = document.getElementById("terminal-cli-input");
        const val = input.value.trim();
        if (!val) return;
        input.value = "";
        executeCodeSnippet(val, "python", "Terminal CLI");
      }
    }

    function switchBottomTab(tab) {
      document.querySelectorAll(".bottom-tab-btn").forEach(b => b.classList.remove("active"));
      const btn = document.getElementById(`tab-${tab}-btn`);
      if (btn) btn.classList.add("active");

      const views = ['terminal', 'output', 'problems', 'tracker'];
      views.forEach(v => {
        const el = document.getElementById(`panel-tab-${v}`);
        if (el) el.style.display = (v === tab) ? (v === 'terminal' || v === 'tracker' ? 'flex' : 'block') : 'none';
      });

      if (tab === 'tracker') {
        refreshPolyglotStack();
      }
    }

    async function refreshPolyglotStack(notify = false) {
      try {
        const res = await fetch("/api/polyglot/stack");
        if (!res.ok) return;
        const data = await res.json();
        const stack = data.stack || {};

        const badgeIcon = document.getElementById("polyglot-stack-icon");
        const badgeName = document.getElementById("polyglot-stack-name");
        if (badgeIcon) badgeIcon.innerHTML = getStackPhysicalIcon(stack);
        if (badgeName) badgeName.innerText = stack.stack_name || "Python Workspace";

        const tIcon = document.getElementById("tracker-active-icon");
        const tName = document.getElementById("tracker-active-name");
        const tTools = document.getElementById("tracker-active-tools");
        if (tIcon) tIcon.innerHTML = getStackPhysicalIcon(stack);
        if (tName) tName.innerText = `${stack.stack_name} (${stack.framework || 'standard'})`;

        const capRes = await fetch("/api/polyglot/discovery");
        if (capRes.ok) {
          const capData = await capRes.json();
          const caps = capData.capabilities || {};
          const installedList = [];
          if (caps.python && caps.python.installed) installedList.push(`Python ${caps.python.version || ''}`);
          if (caps.node && caps.node.installed) installedList.push(`Node ${caps.node.version || ''}`);
          if (caps.docker && caps.docker.installed) installedList.push(`Docker ${caps.docker_daemon_active ? 'Container Active' : 'Subprocess Active'}`);
          if (caps.rust && caps.rust.installed) installedList.push("Rust Ready");
          if (caps.go && caps.go.installed) installedList.push("Go Ready");
          if (tTools) tTools.innerText = installedList.join(" • ") || "Host Runtime Ready";
        }

        if (notify) showToast(`Detected Stack: ${stack.stack_name || 'Python'}`, 'success');
      } catch (err) {
        console.warn("Polyglot stack detection error:", err);
      }
    }

    async function fetchAndDisplayRepoMap() {
      showToast("Generating Repository Map outline...", "info");
      try {
        const res = await fetch("/api/polyglot/repomap");
        if (res.ok) {
          const data = await res.json();
          const mapText = data.repo_map || "No symbols found.";
          appendTerminalOutput(`\n[AIDER REPO MAP OUTLINE]\n${mapText}`);
          switchBottomTab("terminal");
          showToast("Repo map loaded into terminal!", "success");
        }
      } catch (err) {
        showToast(`Repo map error: ${err.message}`, "error");
      }
    }

    // 19. Layout Modes
    function setLayoutMode(mode) {
      document.querySelectorAll(".btn-layout-toggle").forEach(b => b.classList.remove("active"));
      const editorPane = document.getElementById("editor-pane");
      const aiPane = document.getElementById("ai-pane");

      if (mode === "split") {
        document.getElementById("btn-mode-split").classList.add("active");
        editorPane.style.display = "flex";
        aiPane.style.display = "flex";
      } else if (mode === "editor") {
        document.getElementById("btn-mode-editor").classList.add("active");
        editorPane.style.display = "flex";
        aiPane.style.display = "none";
      } else if (mode === "chat") {
        document.getElementById("btn-mode-chat").classList.add("active");
        editorPane.style.display = "none";
        aiPane.style.display = "flex";
      }

      if (isMonacoLoaded && monacoEditor) {
        setTimeout(() => monacoEditor.layout(), 100);
      }
    }

    function toggleSidebar(section) {
      document.getElementById("sidebar-panel").classList.toggle("collapsed");
    }

    document.getElementById("prompt-input").addEventListener("keydown", (e) => {
      if (e.key === "Enter" && !e.shiftKey) {
        e.preventDefault();
        submitChatPrompt();
      }
    });

    let isRecording = false;
    function toggleSpeech() {
      if (!('webkitSpeechRecognition' in window) && !('SpeechRecognition' in window)) {
        alert("Speech Recognition not supported in this browser.");
        return;
      }
      const SpeechRec = window.SpeechRecognition || window.webkitSpeechRecognition;
      const rec = new SpeechRec();
      rec.lang = "sw-KE";
      rec.onstart = () => { isRecording = true; document.getElementById("btn-mic-input").style.color = "#ef4444"; };
      rec.onresult = (e) => {
        document.getElementById("prompt-input").value += " " + e.results[0][0].transcript;
      };
      rec.onend = () => { isRecording = false; document.getElementById("btn-mic-input").style.color = ""; };
      rec.start();
    }

    async function pollTelemetry() {
      try {
        const res = await fetch("/api/system/telemetry");
        if (res.ok) {
          const d = await res.json();
          const latEl = document.getElementById('stat-latency-val');
          const cpuEl = document.getElementById('stat-cpu-val');
          const ramEl = document.getElementById('stat-ram-val');
          if (latEl) latEl.innerText = `${d.latency_ms}ms`;
          if (cpuEl) cpuEl.innerText = `${d.cpu_load_pct}% CPU`;
          if (ramEl) ramEl.innerText = `${d.ram_usage_mb}MB`;
        }
      } catch (e) {}
    }
    setInterval(pollTelemetry, 4500);

    // Sovereign Local Offline Neural Engine Polling & Modal
    async function pollNeuralEngineStatus() {
      try {
        const res = await fetch("/api/neural/status");
        if (res.ok) {
          const d = await res.json();
          const engine = d.neural_engine || {};
          const badge = document.getElementById("local-neural-badge");
          const dot = document.getElementById("local-neural-dot");
          const txt = document.getElementById("local-neural-text");
          const lampCore = document.getElementById("local-neural-lamp-core");
          if (!badge || !dot || !txt) return;

          if (engine.available) {
            if (lampCore) lampCore.setAttribute("fill", "#10b981");
            dot.classList.add("phys-lamp-active");
            txt.innerText = `${engine.provider === 'ollama' ? 'Ollama' : 'Local'}: ${engine.selected_model || 'active'}`;
            badge.style.background = "rgba(16, 185, 129, 0.15)";
            badge.style.borderColor = "rgba(16, 185, 129, 0.4)";
            badge.style.color = "#34d399";
            badge.title = `Local Neural Active (${engine.endpoint}) - Latency: ${engine.latency_ms}ms`;
          } else {
            if (lampCore) lampCore.setAttribute("fill", "#94a3b8");
            dot.classList.remove("phys-lamp-active");
            txt.innerText = "Local Engine: Heuristic Fallback";
            badge.style.background = "rgba(148, 163, 184, 0.1)";
            badge.style.borderColor = "rgba(148, 163, 184, 0.25)";
            badge.style.color = "#94a3b8";
            badge.title = "Local Neural Inactive (Ollama / GGUF not running). Click to view setup instructions.";
          }
        }
      } catch (e) {}
    }
    pollNeuralEngineStatus();
    setInterval(pollNeuralEngineStatus, 10000);

    async function openNeuralEngineModal() {
      const modal = document.getElementById("neural-engine-modal");
      const container = document.getElementById("neural-modal-content");
      if (!modal || !container) return;
      modal.classList.add("open");

      container.innerHTML = `<div style="text-align: center; padding: 20px; color: var(--text-muted);">Probing local neural engine...</div>`;

      try {
        const res = await fetch("/api/neural/status");
        const d = await res.json();
        const eng = d.neural_engine || {};

        let modelsHtml = "";
        if (eng.available && eng.models && eng.models.length > 0) {
          modelsHtml = `
            <div style="background: rgba(16, 185, 129, 0.08); border: 1px solid rgba(16, 185, 129, 0.3); border-radius: 8px; padding: 12px;">
              <div style="display:flex; align-items:center; gap:7px; font-weight: 700; color: #34d399; margin-bottom: 6px;">
                <svg class="phys-icon phys-lamp-active" width="12" height="12" viewBox="0 0 24 24" fill="none">
                  <circle cx="12" cy="12" r="10.5" fill="url(#p-silver)" stroke="#334155" stroke-width="0.8"/>
                  <circle cx="12" cy="12" r="7" fill="url(#p-jewel-run)"/>
                  <circle cx="12" cy="12" r="3" fill="#a7f3d0"/>
                </svg>
                Active Local Neural Provider: ${eng.provider.toUpperCase()} (${eng.endpoint})
              </div>
              <div style="font-size: 12px; color: #cbd5e1; margin-bottom: 8px;">Installed Offline Weights (${eng.models.length}):</div>
              <div style="display: flex; flex-wrap: wrap; gap: 6px;">
                ${eng.models.map(m => `<span style="background: rgba(255,255,255,0.08); padding: 4px 10px; border-radius: 6px; font-family: var(--font-mono); font-size: 11.5px; ${m === eng.selected_model ? 'border: 1px solid #10b981; color: #34d399;' : ''}">${m}</span>`).join('')}
              </div>
              <div style="margin-top: 10px; font-size: 11.5px; color: var(--text-muted);">Connection Latency: <code>${eng.latency_ms}ms</code></div>
            </div>
          `;
        } else {
          modelsHtml = `
            <div style="background: rgba(239, 68, 68, 0.08); border: 1px solid rgba(239, 68, 68, 0.25); border-radius: 8px; padding: 14px;">
              <div style="display:flex; align-items:center; gap:7px; font-weight: 700; color: #f87171; margin-bottom: 6px;">
                <svg class="phys-icon" width="12" height="12" viewBox="0 0 16 16" fill="none">
                  <circle cx="8" cy="8" r="7" fill="url(#p-silver)" stroke="#475569" stroke-width="0.8"/>
                  <circle cx="8" cy="8" r="4" fill="#94a3b8"/>
                </svg>
                Local Neural Engine Inactive (Ollama / LM Studio)
              </div>
              <p style="font-size: 12px; color: #94a3b8; margin-bottom: 12px;">
                Currently operating in <strong>Deterministic Symbolic & Heuristic Mode</strong>. To activate 100% offline, private neural weights on your CPU/RAM with zero cloud fees:
              </p>
              <div style="background: #06090e; border: 1px solid #1e293b; border-radius: 6px; padding: 10px 14px; font-family: var(--font-mono); font-size: 12px; color: #38bdf8; line-height: 1.6;">
                # 1. Install Ollama on Windows<br>
                winget install Ollama.Ollama<br><br>
                # 2. Run recommended lightweight model (~1GB RAM)<br>
                ollama run qwen2.5-coder:1.5b<br><br>
                # Or run full 7B model (8GB RAM)<br>
                ollama run qwen2.5-coder:7b
              </div>
              <p style="font-size: 11.5px; color: #64748b; margin-top: 8px;">
                Or double-click <code>scripts/setup_local_ollama.bat</code> in the workspace.
              </p>
            </div>
          `;
        }

        container.innerHTML = `
          ${modelsHtml}
          <div style="background: rgba(255,255,255,0.03); border: 1px solid var(--border-color); border-radius: 8px; padding: 12px;">
            <div style="display:flex; align-items:center; gap:7px; font-weight: 700; color: #f1f5f9; margin-bottom: 4px;">
              <span class="btn-phys-icon">${PHYSICAL_ICONS.circuit}</span>
              Google Colab 4-Bit QLoRA Fine-Tuned Weights (Option 1)
            </div>
            <p style="font-size: 12px; color: #94a3b8; margin-bottom: 8px;">
              Trained custom weights using <code>notebooks/Train_Anjiru_AI_QLoRA_Colab.ipynb</code> on Google Colab? Export them via <code>Modelfile</code> directly into Ollama:
            </p>
            <div style="background: #06090e; border: 1px solid #1e293b; border-radius: 6px; padding: 8px 12px; font-family: var(--font-mono); font-size: 11.5px; color: #a78bfa;">
              ollama create anjiru -f Modelfile<br>
              ollama run anjiru
            </div>
          </div>
          <div style="display: flex; justify-content: flex-end; gap: 8px; margin-top: 6px;">
            <button class="btn-action" style="padding: 6px 14px; font-size: 12px;" onclick="closeNeuralModal()">Close</button>
            <button class="btn-action primary" style="padding: 6px 14px; font-size: 12px;" onclick="openNeuralEngineModal()">Refresh Status</button>
          </div>
        `;
      } catch (e) {
        container.innerHTML = `<div style="color: #ef4444;">Error probing status: ${e.message}</div>`;
      }
    }

    function closeNeuralModal() {
      const modal = document.getElementById("neural-engine-modal");
      if (modal) modal.classList.remove("open");
    }

    function closeNeuralModalIfOverlay(e) {
      if (e.target.id === "neural-engine-modal") {
        closeNeuralModal();
      }
    }

    function escapeHtml(str) {
      if (!str) return "";
      return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
    }
  </script>
</body>
</html>
